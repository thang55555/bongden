
<%- include("../layout/head", {title: "Danh sách yêu cầu tư vấn"})%>
<%- include("../layout/header")%>
<%- include("../layout/siderbar")%>




	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
		<div class="row">
			<ol class="breadcrumb">
				<li><a href="/admin/dashboard"><svg class="glyph stroked home">
							<use xlink:href="#stroked-home"></use>
						</svg></a></li>
				<li>Danh sách đơn hàng</li>
			</ol>
		</div><!--/.row-->


		

		<div class="row">
			<div class="col-md-12">
				<div class="panel panel-default">
					<div class="panel-body">
						<table data-toolbar="#toolbar" data-toggle="table">

							<thead>
								<tr>
									<th data-field="id" data-sortable="true">ID</th>
									<th>Họ tên</th>
									<th>Liên hệ</th>
									<th>Email</th>
									<th>Địa chỉ</th>
									<th>Nội dung</th>
									<th>Yêu cầu xuất VAT</th>
									<th>Ngày yêu cầu</th>
									<th>Hóa đơn bán hàng</th>
									<th>Trạng thái</th>
									<th>Hành động</th>
								</tr>
							</thead>
							<tbody>
								<% for(item of product){%>
								<tr>
									<td><%=stt++%></td>
									<td><%=item.name%></td>
									<td><%=item.sdt%></td>
									<td><%=item.email%></td>
									<td>
                                        <div style="text-align: left !important; width: 100%;"><%=item.diachigiaohang%></br><%=item.diachigiao%></div></td>
									<td><%=item.note%></td>
									<td style="text-align: left !important; padding-left: 15px;">
                                        <div style="text-align: left !important; width: 100%;">
                                        <% if (item && item.namecty && item.namecty.trim() !== '') { %>
                                       Công ty: <%=item.namecty%></br>
                                       Địa chỉ:<%=item.addcty%></br>
                                       MST: <%=item.tax%>
                                       <%}%>
                                       </div>
                                    </td>
									<td><%= new Intl.DateTimeFormat('en-US').format(item.createdAt)%></td>
<td class="text-center">
    <% 
        // Xác định số lần đã in từ server (nếu chưa có thì mặc định là 0 hoặc lấy item.hoadon)
        let soLanIn = item.hoadon || 0; 
    %>
    <button onclick="inHoaDon('<%= item._id %>', this)" 
            data-count="<%= soLanIn %>"
            style="background: none; border: none; cursor: pointer; display: flex; flex-direction: column; align-items: center; margin: 0 auto;" 
            title="In hóa đơn">
        <i class="fa-solid fa-print" style="font-size: 16px;"></i> 
        
        <!-- Hiển thị chữ tương ứng với số lần in hiện tại -->
        <span class="print-text" style="font-size: 10px; margin-top: 2px; color: <%= soLanIn > 0 ? 'green' : 'inherit' %>; font-weight: <%= soLanIn > 0 ? 'bold' : 'normal' %>;">
            <%= soLanIn > 0 ? `Đã in ${soLanIn} lần` : '' %>
        </span>
    </button>
</td>
									<td> 
										
										<span
                                             class="label label-<%=item.trangthai? 'success': 'danger'%>">
											 <%=item.trangthai? "Đã xử lý" : "Chưa xử lý" %>
                                        </span>
									</td>
									<td class="form-group"> 
										<form action="/admin/edit-order/<%=item.id%>?page=<%=currentPage%>" role="form" method="post">
								
												<select name="trangthai" class="form-control" onchange="this.form.submit()">
													<option value="<%=item.trangthai%>">Chọn</option>
													<option value="true">Đã xử lý</option>
													<option value="flash"> Chưa xử lý</option>
												
												</select>
											</form>
									</td>
								</tr>
								<%}%>
							</tbody>
							
						</table>
					</div>
<% if (totalPages > 1) { %>
    <nav aria-label="Page navigation example" style="text-align: center;" class="mt-6 mb-6">
        <ul class="pagination inline-flex items-center -space-x-px">
            
            <!-- Nút « (Trang trước) -->
            <% if (currentPage > 1) { %>
                <li class="page-item">
                    <a class="page-link px-3 py-2 ml-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-100 hover:text-gray-700" 
                       href="/admin/order?page=<%= currentPage - 1 %>">«</a>
                </li>
            <% } %>

            <!-- Các trang số -->
            <% for(let i = 1; i <= totalPages; i++) { %>
                <!-- Thuật toán rút gọn hiển thị trang để không bị quá dài nếu tổng số trang lớn -->
                <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                    <% if (i === currentPage) { %>
                        <li class="page-item active">
                            <span class="page-link px-3.5 py-2 text-blue-600 border border-gray-300 bg-blue-50 font-semibold"><%= i %></span>
                        </li>
                    <% } else { %>
                        <li class="page-item">
                            <a class="page-link px-3.5 py-2 text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700" 
                               href="/admin/order?page=<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
                <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                    <li class="page-item">
                        <span class="page-link px-3.5 py-2 text-gray-500 bg-white border border-gray-300">...</span>
                    </li>
                <% } %>
            <% } %>

            <!-- Nút » (Trang sau) -->
            <% if (currentPage < totalPages) { %>
                <li class="page-item">
                    <a class="page-link px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-100 hover:text-gray-700" 
                       href="/admin/order?page=<%= currentPage + 1 %>">»</a>
                </li>
            <% } %>

        </ul>
    </nav>
<% } %>
				</div>
			</div>
		</div><!--/.row-->
	</div> <!--/.main-->

    <script>
function inHoaDon(id, btnElement) {
    // 1. Mở trang in hóa đơn ở cửa sổ popup nhỏ
    const printWindow = window.open(`/admin/in-hoa-don/${id}`, '_blank', 'width=900,height=700');

    if (!printWindow) {
        alert("Trình duyệt đang chặn popup. Vui lòng cho phép popup để in hóa đơn!");
        return;
    }

    // 2. Theo dõi khi nào cửa sổ in đóng lại
    const checkClosed = setInterval(() => {
        if (printWindow.closed) {
            clearInterval(checkClosed);
            
            // 3. Lấy số lần in hiện tại từ thuộc tính data-count và tăng lên 1
            let currentCount = parseInt(btnElement.getAttribute('data-count')) || 0;
            currentCount += 1;
            
            // Cập nhật lại thuộc tính data-count
            btnElement.setAttribute('data-count', currentCount);
            
            // 4. Cập nhật giao diện thẻ span thành "Đã in X lần"
            const textSpan = btnElement.querySelector('.print-text');
            if (textSpan) {
                textSpan.textContent = `Đã in ${currentCount} lần`;
                textSpan.style.color = "green";
                textSpan.style.fontWeight = "bold";
            }

            // 5. Gửi request ngầm lên server để cập nhật tăng biến hoadon lên 1 trong Database (Không làm load trang)
            fetch(`/admin/tang-so-lan-in/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                console.log('Đã cập nhật số lần in vào DB:', data);
            })
            .catch(error => {
                console.error('Lỗi khi cập nhật số lần in:', error);
            });
        }
    }, 500);
}
    </script>

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>

	<%- include("../layout/footer")%>