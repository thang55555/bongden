<%- include("../layout/head", {title: "Admin thêm mới menu sản phẩm" })%>
	<%- include("../layout/header")%>
		<%- include("../layout/siderbar")%>


			<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
				<div class="row">
					<ol class="breadcrumb">
						<li><a href="/admin/dashboard"><svg class="glyph stroked home">
									<use xlink:href="#stroked-home"></use>
								</svg></a></li>
						<li><a href="/admin/nhom-san-pham">Menu sản phẩm</a></li>
						<li>Thêm mới menu sản phẩm</li>
					</ol>
				</div><!--/.row-->

				<div class="row">
					<div class="col-lg-12">
						<h1 class="page-header">Thêm menu sản phẩm cho danh mục sản phẩm</h1>
					</div>
				</div><!--/.row-->
				<div class="row">
					<div class="col-lg-12">
						<div class="panel panel-default">
							<div class="panel-body">
								<div class="col-md-6">
									<div class="<%=data.error? " alert alert-danger" : "" %>" ><%=data.error%>
									</div>
									<form name="frm" action="/admin/add-nhom-sp" role="form" method="post"
										enctype="multipart/form-data">
										<div class="form-group">
											<label>Tên menu nhóm sản phẩm :</label>
											<input required type="text" name="name" class="form-control"
												placeholder="Tên menu nhóm sản phẩm...">
										</div>

										<div class="form-group">
											<label>Nhóm Danh mục</label>
											<select name="danhmuc_id" class="form-control" multiple>
												<% for(item of danhmuc){%>
													<option value="<%=item._id%>">
														<%=item.name%>
													</option>
													<%}%>
											</select>
										</div>

										<div class="form-group">
											<label>Ảnh banner</label>

											<input name="images" type="file" required />
											<br>

										</div>
										<!-- 3 thẻ sale -->
										<div class="form-group">
											<label>Thẻ title <span id="label_title"></span></label>
											<input required
												onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)"
												name="title" type="text" class="form-control" placeholder="Title">

											<div class="progress-container">
												<div id="bar_title" class="progress-bar"></div>
											</div>
										</div>


										<div class="form-group">
											<label>Thẻ meta description <span id="label_meta"></span></label>
											<input required
												onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)"
												name="description" type="text" class="form-control"
												placeholder="Meta description...">

											<div class="progress-container">
												<div id="bar_meta" class="progress-bar"></div>
											</div>
										</div>


										<div class="form-group">
											<label>Thẻ meta keywords <span id="label_keywords"></span></label>
											<input required
												onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)"
												name="keywords" type="text" class="form-control"
												placeholder="Meta keywords...">

											<div class="progress-container">
												<div id="bar_keywords" class="progress-bar"></div>
											</div>
										</div>


								</div>
								<div class="col-md-6">

									<div class="form-group">
										<label>Content banner</label>
										<textarea id="description1" required name="content" class="form-control"
											value="" rows="3"></textarea>
										<script>
											CKEDITOR.replace('description1', {
												extraPlugins: 'filebrowser',
												filebrowserBrowseUrl: '/list',//upload location
												filebrowserUploadMethod: 'form',
												filebrowserUploadUrl: '/upload'//route
											});
										</script>
									</div>

<button type="submit" name="sbm" class="btn btn-success">Thêm mới</button>
										<button type="reset" class="btn btn-default">Làm mới</button>


								</div>

								</form>
							</div>
						</div>
					</div>
				</div><!-- /.col-->
			</div> <!--/.main-->

			<script src="js/jquery-1.11.1.min.js"></script>
			<script src="js/bootstrap.min.js"></script>
			<script src="js/bootstrap-table.js"></script>

			<%- include("../layout/footer")%>