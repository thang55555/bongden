
<%- include("../layout/head", {title: "Admin danh sách Nhóm sản phẩm"})%>
<%- include("../layout/header")%>
<%- include("../layout/siderbar")%>




	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
		<div class="row">
			<ol class="breadcrumb">
				<li><a href="/admin/dashboard"><svg class="glyph stroked home">
							<use xlink:href="#stroked-home"></use>
						</svg></a></li>
				<li>Menu danh sách menu sản phẩm</li>
			</ol>
		</div><!--/.row-->

		<div class="row">
			<div class="col-lg-12">
				<h1 class="page-header">Danh sách menu sản phẩm</h1>
			</div>
		</div><!--/.row-->
		<div id="toolbar" class="btn-group">
			<a href="/admin/add-nhom-san-pham" class="btn btn-success">
				<i class="glyphicon glyphicon-plus"></i> Thêm menu sản phẩm
			</a>
		</div>

		<div class="row">
			<div class="col-md-12">
				<div class="panel panel-default">
					<div class="panel-body">
						<table data-toolbar="#toolbar" data-toggle="table">

							<thead>
								<tr>
									<th data-field="id" data-sortable="true">ID</th>
									<th>Hành động</th>
									<th>Tên menu sản phẩm</th>
									<th>Ảnh banner</th>
									<th>Danh mục</th>
									<th>Ngày đăng</th>
								</tr>
							</thead>
							<tbody>
								<% for(item of nhomsanpham){%>
								<tr>
									<td><%=stt++%></td>
									<td class="form-group">
										<a href="/admin/edit-nhom-san-pham/<%=item._id%>"><i class="fa-solid fa-pen-to-square"></i></a>
										<a onclick="clickDelete('<%=item._id%>')"  ><i class="fa-solid fa-trash" style="color: rgb(48, 165, 255);"></i></a>
											<a href="/category?danh-muc=<%=item.slug%>&id=<%=item._id%>"
														target="_blank">
														<i class="fa-solid fa-eye"></i> </a>
									</td>
									<td><%=item.name%></td>
									 <td style="text-align: center"><img width="130" height="180"
                                                        src="../site/images/update/<%=item.images%>" /></td>
									<td>
    <%- item.danhmuc_id && item.danhmuc_id.length > 0 
        ? item.danhmuc_id.map(dm => dm.name).join('</br> ') 
        : '' %>
</td>
									<td><%= new Intl.DateTimeFormat('en-US').format(item.createdAt)%></td>
									
								</tr>
								<%}%>
								
							</tbody>
						</table>
					</div>

				</div>
			</div>
		</div><!--/.row-->
	</div> <!--/.main-->
	<script>
		function handleConfirm(id) {
		  const isConfirm = confirm(`Bạn có chắc chắn xóa không?`)
		  const link = () => window.location.href = `/admin/delete-nhom-san-pham/${id}`
		  return isConfirm ? link() : false
		}
		const clickDelete = (id) => handleConfirm(id)
	  </script>

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>

	<%- include("../layout/footer")%>