<%- include("../layout/head", {title: "ADMIN NAM THÀNH PHÁT SHOP"})%>
<%- include("../layout/header")%>
<%- include("../layout/siderbar")%>


	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main" style="padding-top: 3%;">
	 <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #f0f2f5;
      padding: 20px;
    }

    h2 {
      text-align: center;
      margin-bottom: 30px;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 20px;
    }

    .photo-card {
      position: relative;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      transition: transform 0.2s ease;
      cursor: pointer;
    }

    .photo-card:hover {
      transform: translateY(-4px);
    }

    .photo-card img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      display: block;
    }

    .photo-footer {
      text-align: center;
      font-size: 14px;
      color: #555;
      padding: 10px;
    }

    .delete-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background-color: rgba(220, 53, 69, 0.9);
      color: #fff;
      border: none;
      padding: 6px 10px;
      font-size: 13px;
      border-radius: 5px;
      cursor: pointer;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .photo-card:hover .delete-btn {
      opacity: 1;
    }

    .delete-btn:hover {
      background-color: rgba(200, 35, 50, 0.95);
    }
  </style>
    <h2>DANH SÁCH ẢNH TIÊU ĐỀ </h2>

<div class="gallery">
  <% for(item of image) { %>
    <div class="photo-card" data-id="<%= item._id %>">
      <img src="../site/images/update/<%= item.images %>" alt="<%= item.images %>">
      <button class="delete-btn" onclick="deleteImage(this, '<%= item._id %>')">Xoá</button>
      <div class="photo-footer"><%= item.images %></div>
    </div>
  <% } %>
</div>

<% if(totalPages > 1){ %>
<nav class="pagination-modern">
    <% if(page > 1){ %>
        <a href="/admin/danh-sach-anh/tieu-de?page=<%= page-1 %>" class="page-btn">
            <i class="fa fa-angle-left"></i>
        </a>
    <% } %>

    <% for(let i=1;i<=totalPages;i++){ %>

        <% if(
            i==1 ||
            i==totalPages ||
            (i>=page-2 && i<=page+2)
        ){ %>

            <a href="/admin/danh-sach-anh/tieu-de?page=<%= i %>"
               class="page-btn <%= i==page?'active':'' %>">
                <%= i %>
            </a>

        <% } %>

    <% } %>

    <% if(page < totalPages){ %>
        <a href="/admin/danh-sach-anh/tieu-de?page=<%= page+1 %>" class="page-btn">
            <i class="fa fa-angle-right"></i>
        </a>
    <% } %>
</nav>
<% } %>

<style>
  .pagination-modern{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
    margin:40px 0;
    flex-wrap:wrap;
}

.page-btn{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    border-radius:12px;
    background:#fff;
    color:#444;
    font-weight:600;
    border:1px solid #e5e5e5;
    transition:.25s;
    box-shadow:0 2px 10px rgba(0,0,0,.05);
}

.page-btn:hover{
    background:#0d6efd;
    color:#fff;
    transform:translateY(-2px);
    box-shadow:0 10px 25px rgba(13,110,253,.25);
}

.page-btn.active{
    background:#0d6efd;
    color:#fff;
    border-color:#0d6efd;
    box-shadow:0 10px 25px rgba(13,110,253,.3);
}
</style>

<script>
  function deleteImage(button, id) {
    if (confirm("Bạn có chắc muốn xoá ảnh này?")) {
      fetch(`/admin/danh-sach-anh/delete-tieu-de/${id}`, {
        method: 'DELETE',
      })
      .then(response => {
        if (response.ok) {
          // Xoá phần tử ảnh khỏi DOM
          button.closest('.photo-card').remove();
        } else {
          alert("Xoá ảnh thất bại!");
        }
      })
      .catch(error => {
        console.error("Lỗi khi xoá ảnh:", error);
        alert("Đã xảy ra lỗi khi kết nối tới server!");
      });
    }
  }
</script>

	</div> <!--/.main-->

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>
 

	<%- include("../layout/footer")%>
	