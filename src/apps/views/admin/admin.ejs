<%- include("./layout/head", {title: "ADMIN NAM THÀNH PHÁT SHOP"})%>
<%- include("./layout/header")%>
<%- include("./layout/siderbar")%>


	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
		<div class="row">
			<ol class="breadcrumb">
				<li><a href="/admin/dashboard"><svg class="glyph stroked home">
							<use xlink:href="#stroked-home"></use>
						</svg></a></li>
				<li>Trang chủ quản trị</li>
			</ol>
		</div><!--/.row-->

		<div class="row">
			<div class="col-lg-12">
				<h1 class="page-header">Trang chủ quản trị</h1>
			</div>
		</div><!--/.row-->



<div class="row">
    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-blue panel-widget">
            <a href="/admin/danh-sach-san-pham">
                <div style="display: flex; align-items: center;">
                    <div class="widget-left"><svg class="glyph stroked bag"><use xlink:href="#stroked-bag"></use></svg></div>
                    <div>
                        <div class="large"><%= product %></div>
                        <div class="text-muted">Sản Phẩm</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-blue panel-widget">
            <a href="/admin/danh-sach-video">
                <div style="display: flex; align-items: center;">
                    <div class="widget-left"><svg class="glyph stroked camcorder"><use xlink:href="#stroked-camcorder"></use></svg></div>
                    <div>
                        <div class="large"><%= video %></div>
                        <div class="text-muted">Video</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-blue panel-widget">
            <a href="/admin/danh-sach-bai-viet-tin-tuc">
                <div style="display: flex; align-items: center;">
                    <div class="widget-left"><svg class="glyph stroked pencil"><use xlink:href="#stroked-pencil"></use></svg></div>
                    <div>
                        <div class="large"><%= tintuc %></div>
                        <div class="text-muted">Bài viết tin tức</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-blue panel-widget">
            <a href="/admin/bai-viet-dich-vu">
                <div style="display: flex; align-items: center;">
                    <div class="widget-left"><svg class="glyph stroked pencil"><use xlink:href="#stroked-pencil"></use></svg></div>
                    <div>
                        <div class="large"><%= dichvu %></div>
                        <div class="text-muted">Bài viết dự án</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-blue panel-widget">
            <a href="/admin/chia-se-khach-hang">
                <div style="display: flex; align-items: center;">
                    <div class="widget-left"><svg class="glyph stroked two messages"><use xlink:href="#stroked-two-messages"></use></svg></div>
                    <div>
                        <div class="large"><%= chiase %></div>
                        <div class="text-muted">Chia sẻ khách hàng</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-blue panel-widget">
            <a href="/admin/danh-sach-anh">
                <div style="display: flex; align-items: center;">
                    <div class="widget-left"><svg class="glyph stroked camera"><use xlink:href="#stroked-camera"></use></svg></div>
                    <div>
                        <div class="large"><%= image %></div>
                        <div class="text-muted">Thư viện ảnh</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-orange panel-widget">
            <a href="/admin/danh-sach-yeu-cau-tu-van">
                <div style="display: flex; align-items: center;">
                    <div class="widget-left"><svg class="glyph stroked empty-message"><use xlink:href="#stroked-empty-message"></use></svg></div>
                    <div>
                        <div class="large"><%= tuvan %></div>
                        <div class="text-muted">Yêu cầu tư vấn</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-3">
        <div class="panel panel-teal panel-widget">
            <div style="display: flex; align-items: center;">
                <div class="widget-left"><svg class="glyph stroked male-user"><use xlink:href="#stroked-male-user"></use></svg></div>
                <div>
                    <div class="large"><%= users %></div>
                    <div class="text-muted">Thành Viên</div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
	/* Thiết lập chung cho widget */
.panel-widget {
    background: #fff;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    border: none !important;
    transition: all 0.3s ease;
    margin-bottom: 25px;
    cursor: pointer;
}

.panel-widget:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

/* Icon box - Tự động đổi màu dựa trên class panel-xx */
.widget-left {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    width: 60px;
    border-radius: 12px;
    margin-right: 15px;
}

.panel-blue .widget-left { background: rgba(48, 164, 255, 0.15); color: #30a5ff; }
.panel-orange .widget-left { background: rgba(255, 184, 0, 0.15); color: #ffb800; }
.panel-teal .widget-left { background: rgba(90, 203, 192, 0.15); color: #5acbc0; }
.panel-red .widget-left { background: rgba(249, 89, 89, 0.15); color: #f95959; }

/* Định dạng chữ */
.large { font-size: 28px; font-weight: 800; color: #2d3436; margin-bottom: 4px; }
.text-muted { font-size: 13px; color: #636e72; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 600; }
.panel-widget a { text-decoration: none !important; color: inherit; }
</style>

	</div> <!--/.main-->

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>
 

	<%- include("./layout/footer")%>
	