<%- include("../layout/head", {title: "Admin update danh mục sản phẩm" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>


            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li><a href="/admin/danh-muc-san-pham">Quản lý menu danh mục sản phẩm</a></li>
                        <li>Danh mục <%=danhmuc.name%>
                        </li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Danh mục: <%=danhmuc.name%>
                        </h1>
                    </div>
                </div><!--/.row-->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <div class="col-md-8">

                                    <form name="frm" role="form" method="post" enctype="multipart/form-data"
                                        action="/admin/update-danh-muc-san-pham/<%=danhmuc._id%>">
                                        <div class="form-group">
                                            <label>Tên danh mục:</label>
                                            <input type="text" name="name" value="<%=danhmuc.name%>"
                                                required value="Danh mục 1" class="form-control"
                                                placeholder="Tên danh mục...">
                                        </div>

                                        <div class="form-group">
                                            <label>Icon: <a href="https://fontawesome.com/v6/search"> Lấy icon tại
                                                    đây</a></label>
                                            <input required type="text" name="icon" class="form-control"
                                                value="<%=danhmuc.icon%>" placeholder="Tên danh mục...">
                                        </div>
                                                                            <div class="form-group">
                                        <label>Ảnh banner</label>
                                        <input name="images" type="file">
                                        <br>
                                        <div>
                                            <img src="../site/images/update/<%=danhmuc.images%>" width="150px"
                                                height="150px">
                                        </div>
                                    </div>

                                        <div class="form-group">
                                            <label>Thẻ title <span id="label_title"></span></label>
                                            <input required
                                                onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)"
                                                name="title" type="text" class="form-control" placeholder="Title"
                                                value="<%=danhmuc.title%>">

                                            <div class="progress-container">
                                                <div id="bar_title" class="progress-bar"></div>
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <label>Thẻ meta description <span id="label_meta"></span></label>
                                            <input required
                                                onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)"
                                                name="description" type="text" class="form-control"
                                                placeholder="Meta description..." value="<%=danhmuc.description%>">

                                            <div class="progress-container">
                                                <div id="bar_meta" class="progress-bar"></div>
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <label>Thẻ meta keywords <span id="label_keywords"></span></label>
                                            <input required
                                                onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)"
                                                name="keywords" type="text" class="form-control"
                                                placeholder="Meta keywords..." value="<%=danhmuc.keywords%>">

                                            <div class="progress-container">
                                                <div id="bar_keywords" class="progress-bar"></div>
                                            </div>
                                        </div>




                                        <div class="form-group">
                                            <label>Giới thiệu menu danh mục</label>
                                            <textarea id="description" required name="content" class="form-control"
                                                value="" rows="3"><%=danhmuc.content%></textarea>
                                            <script>
                                                CKEDITOR.replace('description', {
                                                    extraPlugins: 'filebrowser',
                                                    filebrowserBrowseUrl: '/list',//upload location
                                                    filebrowserUploadMethod: 'form',
                                                    filebrowserUploadUrl: '/upload'//route
                                                });
                                            </script>
                                        </div>





                                        <button type="submit" name="sbm" class="btn btn-primary">Cập nhật</button>
                                        <button type="reset" class="btn btn-default">Làm mới</button>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div><!-- /.col-->
                </div>
            </div> <!--/.main-->

            <script src="js/jquery-1.11.1.min.js"></script>
            <script src="js/bootstrap.min.js"></script>
            <script src="js/bootstrap-table.js"></script>


            <%- include("../layout/footer")%>