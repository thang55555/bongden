<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SEO Checker</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background:#f5f7fb;
    font-family:Arial;
}

.container-box{
    max-width:900px;
    margin:80px auto;
}

.card{
    border:none;
    border-radius:15px;
    box-shadow:0 5px 25px rgba(0,0,0,.08);
}

.score-circle{
    width:160px;
    height:160px;
    border-radius:50%;
    background:linear-gradient(135deg,#28a745,#38d86f);
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:55px;
    font-weight:bold;
    margin:auto;
}

.check-item{
    display:flex;
    justify-content:space-between;
    padding:12px 15px;
    border-bottom:1px solid #eee;
}

.good{
    color:#28a745;
    font-weight:bold;
}

.bad{
    color:red;
    font-weight:bold;
}

.warning{
    color:#ff9800;
    font-weight:bold;
}

</style>

</head>

<body>

<div class="container-box">

<div class="card p-5">

<h2 class="text-center mb-4">
SEO Website Checker
</h2>

<div class="input-group mb-4">

<input
type="text"
id="url"
class="form-control form-control-lg"
placeholder="https://example.com">

<button
class="btn btn-success btn-lg"
onclick="checkSEO()">
Kiểm tra SEO
</button>

</div>

<div id="result" style="display:none">

<div class="score-circle" id="score">
87
</div>

<h3 class="text-center mt-3 mb-4">
Điểm SEO
</h3>

<div class="card">

<div class="check-item">
<span>Tiêu đề (Title)</span>
<span class="good">✔ Tốt</span>
</div>

<div class="check-item">
<span>Meta Description</span>
<span class="good">✔ Có</span>
</div>

<div class="check-item">
<span>H1</span>
<span class="good">✔ Có</span>
</div>

<div class="check-item">
<span>HTTPS</span>
<span class="good">✔ Có</span>
</div>

<div class="check-item">
<span>Canonical</span>
<span class="warning">⚠ Thiếu</span>
</div>

<div class="check-item">
<span>Open Graph</span>
<span class="warning">⚠ Thiếu</span>
</div>

<div class="check-item">
<span>Robots Meta</span>
<span class="good">✔ Có</span>
</div>

<div class="check-item">
<span>Image Alt</span>
<span class="bad">✘ Chưa đủ</span>
</div>

<div class="check-item">
<span>Schema.org</span>
<span class="bad">✘ Không có</span>
</div>

<div class="check-item">
<span>Sitemap.xml</span>
<span class="good">✔ Có</span>
</div>

<div class="check-item">
<span>robots.txt</span>
<span class="good">✔ Có</span>
</div>

</div>

</div>

</div>

</div>

<script>

function checkSEO(){

let url=document.getElementById("url").value;

if(url==""){
    alert("Nhập website");
    return;
}

document.getElementById("result").style.display="block";

}

</script>

</body>
</html>