<%- include("../layout/head", {title: "Admin update thông tin trang" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>


            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li><a href="/admin/thong-tin-trang">Thông tin trang</a></li>
                        <li>Update thông tin trang</li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Update thông tin trang</h1>
                    </div>
                </div><!--/.row-->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <div class="col-md-6">
                                    <form role="form" method="post"
                                        action="/admin/update-thong-tin-trang/<%=thongtin._id%>"
                                        enctype="multipart/form-data">
                                        <div class="form-group">
                                            <label>Số điện thoại</label>
                                            <input required name="sdt" type="text" class="form-control"
                                                value="<%=thongtin.sdt%>" placeholder="">
                                        </div>

                                        <div class="form-group">
                                            <label>Email</label>
                                            <input required name="email" type="text" value="<%=thongtin.email%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Tên công ty</label>
                                            <input required name="name" type="text" value="<%=thongtin.name%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Địa chỉ công ty</label>
                                            <input required name="diachi" type="text" value="<%=thongtin.diachi%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Mã số thuế</label>
                                            <input required name="mst" type="text" value="<%=thongtin.mst%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Content ngắn chân trang</label>
                                            <input required name="content" type="text" value="<%=thongtin.content%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Facebook</label>
                                            <input required name="fb" type="text" value="<%=thongtin.fb%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Youtube</label>
                                            <input required name="yt" type="text" value="<%=thongtin.yt%>"
                                                class="form-control">
                                        </div>
                                        <div class="form-group">
                                            <label>Zalo</label>
                                            <input required name="zalo" type="text" value="<%=thongtin.zalo%>"
                                                class="form-control">
                                        </div>
                                        <!-- 3 thẻ sale -->
                                        <div class="form-group">
                                            <label>Thẻ title <span id="label_title"></span></label>
                                            <input required
                                                onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)"
                                                name="title" type="text" class="form-control" placeholder="Title"
                                                value="<%=thongtin.title%>">

                                            <div class="progress-container">
                                                <div id="bar_title" class="progress-bar"></div>
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <label>Thẻ meta description <span id="label_meta"></span></label>
                                            <input required
                                                onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)"
                                                name="description" type="text" class="form-control"
                                                placeholder="Meta description..." value="<%=thongtin.description%>">

                                            <div class="progress-container">
                                                <div id="bar_meta" class="progress-bar"></div>
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <label>Thẻ meta keywords <span id="label_keywords"></span></label>
                                            <input required
                                                onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)"
                                                name="keywords" type="text" class="form-control"
                                                placeholder="Meta keywords..." value="<%=thongtin.keywords%>">

                                            <div class="progress-container">
                                                <div id="bar_keywords" class="progress-bar"></div>
                                            </div>
                                        </div>

                                </div>
                                <div class="col-md-6">


                                    <div class="form-group">
                                        <label>Ảnh Logo cty</label>
                                        <input name="images" type="file">
                                        <br>
                                        <div>
                                            <img src="../site/images/update/<%=thongtin.images%>" width="150px"
                                                height="150px">
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label>Giới thiệu trang</label>
                                        <textarea id="description2" name="gioithieu" class="form-control" value=""
                                            rows="3"><%=thongtin.gioithieu%></textarea>
                                        <script>
                                            CKEDITOR.replace('description2', {
                                                extraPlugins: 'filebrowser',
                                                filebrowserBrowseUrl: '/list',//upload location
                                                filebrowserUploadMethod: 'form',
                                                filebrowserUploadUrl: '/upload'//route
                                            });
                                        </script>
                                    </div>
                                    <button name="sbm" type="submit" class="btn btn-success">update</button>
                                    <button type="reset" class="btn btn-default">Làm mới</button>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div><!-- /.col-->
                </div><!-- /.row -->

            </div> <!--/.main-->

            <script src="js/jquery-1.11.1.min.js"></script>
            <script src="js/bootstrap.min.js"></script>


            <%- include("../layout/footer")%>