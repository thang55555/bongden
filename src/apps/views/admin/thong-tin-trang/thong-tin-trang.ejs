<%- include("../layout/head", {title: "Admin thông tin trang"})%>
<%- include("../layout/header")%>
<%- include("../layout/siderbar")%>

	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
		<div class="row">
			<ol class="breadcrumb">
				<li><a href="/admin/dashboard"><svg class="glyph stroked home">
							<use xlink:href="#stroked-home"></use>
						</svg></a></li>
				<li>Thông tin trang</li>
			</ol>
		</div><!--/.row-->

		<div class="row">
			<div class="col-lg-12">
				<h1 class="page-header">Thông tin trang</h1>
			</div>
		</div><!--/.row-->
	 
		<div class="row">
			<div class="col-lg-12">
				<div class="panel panel-default">
					<div class="panel-body">
						<table data-toolbar="#toolbar" data-toggle="table">

							<thead>
								<tr>
									<th data-field="id" data-sortable="true">ID</th>
									<th>Hành Động</th>
									<th data-field="name" data-sortable="true">Số điện thoại</th>
									<th data-field="price" data-sortable="true">Email</th>
									<th>Logo cty</th>
									<th>Tên công ty</th>
									<th>Địa chỉ công ty</th>
									<th>Facebook</th>
									<th>Youtube</th>
									<th>Zalo</th>
									<th>Giới thiệu chân trang</th>
									<th>Giới thiệu trang</th>


								</tr>
							</thead>
							<tbody>
								<% for(thongtin of thongtintrang){%>
								<tr>
									<td>1</td>
									<td class="form-group">
										<a href="/admin/edit-thong-tin-trang/<%=thongtin._id%>" ><i class="fa-solid fa-pen-to-square"></i></a>
											<a href="/gioi-thieu"
														target="_blank">
														<i class="fa-solid fa-eye"></i> </a>
									</td>
									<td><%=thongtin.sdt%></td>
									<td><%=thongtin.email%></td>
									<td style="text-align: center"><img width="150" height="150"
											src="../site/images/update/<%=thongtin.images%>" /></td>
	
									<td><%=thongtin.name%></td>
									<td><%=thongtin.diachi%></td>
									<td><%=thongtin.fb%></td>
									<td><%=thongtin.yt%></td>
									<td><%=thongtin.zalo%></td>
									<td><div class="antext"><%-thongtin.content%></div></td>
									<td><div class="antext"><%-thongtin.gioithieu%></div></td>

									
								</tr>
								<%}%>
							</tbody>
							
						</table>
					</div>
				</div>
			</div>
		</div><!--/.row-->
	</div> <!--/.main-->

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>


	<%- include("../layout/footer")%>