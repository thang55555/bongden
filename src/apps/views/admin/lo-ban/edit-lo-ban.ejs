<%- include("../layout/head", {title: "Admin update thước lỗ ban"})%>
<%- include("../layout/header")%>
<%- include("../layout/siderbar")%>


    <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">			
		<div class="row">
			<ol class="breadcrumb">
                <li><a href="/admin/dashboard"><svg class="glyph stroked home"><use xlink:href="#stroked-home"></use></svg></a></li>
                <li><a href="/admin/thuoc-lo-ban">Thước lỗ ban</a></li>
				<li>Update thước lỗ ban</li>
			</ol>
		</div><!--/.row-->
		
		<div class="row"> 
			<div class="col-lg-12">
				<h1 class="page-header">Update thước lỗ ban</h1>
			</div>
        </div><!--/.row-->
        <div class="row">
                <div class="col-lg-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="col-md-6">
                                <form action="/admin/update-thuoc-lo-ban/<%=product._id%>" role="form" method="post" enctype="multipart/form-data">
                                
                                    <div class="form-group">
                                        <label>Content thước lỗ ban</label>
                                        <textarea id="description" required name="content" class="form-control" value="" rows="3"><%=product.content%></textarea>
                                        <script>
                                            CKEDITOR.replace( 'description' ,{
                                            extraPlugins:'filebrowser',
                                            filebrowserBrowseUrl:'/list',//upload location
                                            filebrowserUploadMethod:'form',
                                            filebrowserUploadUrl:'/upload'//route
                                        });
                                        </script>
                                    </div>
<div class="form-group">
    <label>Thẻ title <span id="label_title"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)" 
           name="title" type="text" class="form-control" placeholder="Title" value="<%=product.title%>">
    
    <div class="progress-container">
        <div id="bar_title" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta description <span id="label_meta"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)" 
           name="metadescription" type="text" class="form-control" placeholder="Meta description..." value="<%=product.metadescription%>">
    
    <div class="progress-container">
        <div id="bar_meta" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta keywords <span id="label_keywords"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)" 
           name="metakeywords" type="text" class="form-control" placeholder="Meta keywords..." value="<%=product.metakeywords%>" >
    
    <div class="progress-container">
        <div id="bar_keywords" class="progress-bar"></div>
    </div>
</div>
                 
                            

                                <button name="sbm" type="submit" class="btn btn-success">Update</button>
                            </div>
                        </form>
                        </div>
                    </div>
                </div><!-- /.col-->
            </div><!-- /.row -->
		
	</div>	<!--/.main-->	

    <script src="js/jquery-1.11.1.min.js"></script>
    <script src="js/bootstrap.min.js"></script>

    <%- include("../layout/footer")%>