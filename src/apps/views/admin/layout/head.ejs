<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<!-- seo + đếm từ -->
<style>
    .progress-container {
    width: 100%;
    background-color: #e0e0e0;
    border-radius: 5px;
    height: 8px;
    margin-top: 5px;
}
.progress-bar {
    height: 100%;
    width: 0%;
    border-radius: 5px;
    transition: width 0.3s, background-color 0.3s;
}
</style>
<script>
    function updateAll(val, barId, labelId, min, max) {
        const bar = document.getElementById(barId);
        const label = document.getElementById(labelId);
        const len = val.length;

        // 1. Tính % thanh tiến trình (Max là mốc 100%)
        let percent = (len / max) * 100;
        bar.style.width = (percent > 100 ? 100 : percent) + "%";

        // 2. Logic màu sắc và trạng thái (Đỏ -> Vàng -> Xanh -> Đỏ)
        let status = "";
        let color = "";

        // Khoảng 1: Đỏ (Quá ngắn - từ 0 đến trước 50% của Min)
        if (len < (min * 0.5)) {
            status = "Quá ngắn";
            color = "#ff4d4d"; // Đỏ
        } 
        // Khoảng 2: Vàng (Đang tốt - từ 50% của Min đến trước Min)
        else if (len < min) {
            status = "Khá tốt";
            color = "#ffc107"; // Vàng
        } 
        // Khoảng 3: Xanh (Chuẩn SEO - từ Min đến Max)
        else if (len <= max) {
            status = "Chuẩn SEO";
            color = "#28a745"; // Xanh
        } 
        // Khoảng 4: Đỏ (Quá dài - vượt quá Max)
        else {
            status = "Quá dài";
            color = "#ff4d4d"; // Đỏ
        }

        // 3. Cập nhật giao diện
        bar.style.backgroundColor = color;
        label.innerHTML = ": " + len + " ký tự <b>(" + status + ")</b>";
        label.style.color = color;
    }
</script>
</head>