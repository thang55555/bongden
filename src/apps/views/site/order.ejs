        <label class="option-item">
            <div class="option-info">
                <input type="radio" name="shipping_method" value="Giao hàng tiêu chuẩn (1 - 3 ngày)" data-fee="30000" checked>
                <span class="option-title">Giao hàng tiêu chuẩn (1 - 3 ngày)</span>
            </div>
            <span class="option-price">30.000đ</span>
        </label>
        <label class="option-item">
            <div class="option-info">
                <input type="radio" name="shipping_method" value="Giao hàng nhanh (Trong ngày)" data-fee="30000">
                <span class="option-title">Giao hàng nhanh (Trong ngày)</span>
            </div>
            <span class="option-price fee">30.000đ</span>
        </label>
        <label class="option-item">
            <div class="option-info">
                <input type="radio" name="shipping_method" value="Giao hàng hỏa tốc (2 - 4 giờ)" data-fee="60000">
                <span class="option-title">Giao hàng hỏa tốc (2 - 4 giờ)</span>
            </div>
            <span class="option-price fee">60.000đ</span>
        </label>
    </div>
</div>

                    <!-- 4. PHƯƠNG THỨC THANH TOÁN -->
                    <div class="form-section">
                        <h2 class="section-heading">4. PHƯƠNG THỨC THANH TOÁN</h2>
                        <div class="option-card-list">
                            <label class="option-item" style="align-items: flex-start;">
                                <div class="option-info">
                                    <input type="radio" name="payment_method" value="Thanh toán khi nhận hàng (COD)" checked
                                        style="margin-top: 3px;">
                                    <div class="option-text-group">
                                        <span class="option-title">Thanh toán khi nhận hàng (COD)</span>
                                        <span class="option-desc">Thanh toán bằng tiền mặt khi nhận hàng</span>
                                    </div>
                                </div>
                            </label>
                            <label class="option-item" style="align-items: flex-start;">
                                <div class="option-info">
                                    <input type="radio" name="payment_method" value="Chuyển khoản ngân hàng"
                                        style="margin-top: 3px;">
                                    <div class="option-text-group">
                                        <span class="option-title">Chuyển khoản ngân hàng</span>
                                        <span class="option-desc">Bạn sẽ nhận được thông tin tài khoản sau khi đặt hàng</span>
                                    </div>
                                </div>
                            </label>
                            <label class="option-item" style="align-items: flex-start;">
                                <div class="option-info">
                                    <input type="radio" name="payment_method" value="Thanh toán qua thẻ ATM / Internet Banking"
                                        style="margin-top: 3px;">
                                    <div class="option-text-group">
                                        <span class="option-title">Thanh toán qua thẻ ATM / Internet Banking</span>
                                        <span class="option-desc">Thanh toán qua cổng thanh toán an toàn</span>
                                    </div>
                                </div>
                            </label>
                            <label class="option-item" style="align-items: flex-start;">
                                <div class="option-info">
                                    <input type="radio" name="payment_method" value="Thanh toán qua MoMo, ZaloPay, VNPay" style="margin-top: 3px;">
                                    <div class="option-text-group">
                                        <span class="option-title">Ví điện tử</span>
                                        <span class="option-desc">Thanh toán qua MoMo, ZaloPay, VNPay</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Terms and Submit Button Area -->
                    <div class="terms-submit-area">
                        <div class="checkbox-group terms-row">
                            <!-- Đã xóa 'checked' và thêm 'required' -->
                            <input type="checkbox" id="terms-check" name="agree_terms" value="1" required>
                            <label for="terms-check">Tôi đồng ý với <a>Điều khoản sử dụng</a> và <a>Chính sách bảo
                                    mật</a> của LTC Lighting</label>
                        </div>
                        <!-- Đổi type thành submit nếu bạn muốn nút này dùng để gửi form trực tiếp -->
                        <button type="submit" class="submit-order-btn">
                            <i class="fa-solid fa-lock"></i> ĐẶT HÀNG
                        </button>
                        <div class="sms-note">Bạn sẽ nhận được xác nhận đơn hàng qua SMS/Email</div>
                    </div>
                </form>
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const termsCheckbox = document.getElementById("terms-check");

                    if (termsCheckbox) {
                        termsCheckbox.addEventListener("invalid", function (e) {
                            // Tùy chỉnh câu thông báo khi chưa tích
                            this.setCustomValidity("Vui lòng đồng ý với điều khoản sử dụng để tiếp tục.");
                        });

                        termsCheckbox.addEventListener("change", function (e) {
                            // Xóa thông báo lỗi khi người dùng đã tích vào
                            this.setCustomValidity("");
                        });
                    }
                });
            </script>




            <!-- Right Column: Order Summary -->
<!-- CỘT TỔNG KẾT BÊN PHẢI -->
<div class="checkout-summary-column">
    <div class="order-summary-box">
        <div class="summary-header">
            <span>ĐƠN HÀNG CỦA BẠN (<%=cart.length%> sản phẩm)</span>
            <a href="/gio-hang" class="edit-cart-link">Sửa đơn hàng</a>
        </div>

        <div class="summary-items-list">
            <% for(item of cart) { %>
            <div class="summary-item">
                <div class="summary-item-left">
                    <img src="../site/images/update/<%=item.thumbnail%>" class="summary-item-img" alt="<%=item.name%>">
                    <div class="summary-item-details">
                        <span class="summary-item-name"><%=item.name%></span>
                        <span class="summary-item-variant"><%=item.anhsang%></span>
                        <span class="summary-item-qty">x <%=item.qty%></span>
                    </div>
                </div>
                <span class="summary-item-price"><%= Number(item.price * item.qty).toLocaleString('vi-VN') %>₫</span>
            </div>
            <% } %>
        </div>

        <!-- Calculation lines -->
        <div class="calc-row">
            <span>Tạm tính</span>
            <span id="sub-total" data-value="<%= totalPrice %>"><%= Number(totalPrice).toLocaleString('vi-VN') %>₫</span>
        </div>
        
        <div class="calc-row">
            <span>Phí vận chuyển</span>
            <span id="shipping-fee-text">0đ</span>
        </div>
        
        <!-- Dòng thông báo mua thêm để được freeship (chỉ hiện khi dưới 1tr và chọn tiêu chuẩn) -->
        <div id="freeship-msg" style="font-size: 12px; color: #e11d48; margin-bottom: 8px; display: none;">
            Mua thêm <span id="missing-amount">0</span>đ để được miễn phí vận chuyển.
        </div>

        <div class="calc-row discount">
            <span>Giảm giá</span>
            <span>0đ</span>
        </div>

        <!-- Total Row -->
        <div class="total-row">
            <span class="total-label">TỔNG CỘNG</span>
            <div class="total-amount-group">
                <span class="total-price-val" id="final-total"><%= Number(totalPrice).toLocaleString('vi-VN') %>₫</span>
                <span class="vat-note">(Đã bao gồm VAT)</span>
            </div>
        </div>
    </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", function () {
    const subTotal = Number(document.getElementById("sub-total").getAttribute("data-value"));
    const shippingRadios = document.querySelectorAll("input[name='shipping_method']");
    const shippingFeeText = document.getElementById("shipping-fee-text");
    const finalTotalEl = document.getElementById("final-total");
    const freeshipMsg = document.getElementById("freeship-msg");
    const missingAmountEl = document.getElementById("missing-amount");

    function updateCheckout() {
        const selectedRadio = document.querySelector("input[name='shipping_method']:checked");
        if (!selectedRadio) return;

        let baseShippingFee = Number(selectedRadio.getAttribute("data-fee"));
        let finalShippingFee = 0;
        let shippingText = "";

        const isStandard = selectedRadio.value.includes("tiêu chuẩn");

        if (isStandard) {
            if (subTotal >= 1000000) {
                finalShippingFee = 0;
                shippingText = "Miễn phí";
                freeshipMsg.style.display = "none";
            } else {
                finalShippingFee = 30000;
                shippingText = "30.000đ";
                const missing = 1000000 - subTotal;
                missingAmountEl.textContent = missing.toLocaleString('vi-VN');
                freeshipMsg.style.display = "block";
            }
        } else {
            // Các gói nhanh hoặc hỏa tốc
            finalShippingFee = baseShippingFee;
            shippingText = finalShippingFee.toLocaleString('vi-VN') + "đ";
            freeshipMsg.style.display = "none"; // Không hiện thông báo freeship khi chọn gói nhanh/hỏa tốc
        }

        // Cập nhật giao diện phí ship
        shippingFeeText.textContent = shippingText;

        // Cập nhật tổng cộng = Tạm tính + Phí vận chuyển
        const grandTotal = subTotal + finalShippingFee;
        finalTotalEl.textContent = grandTotal.toLocaleString('vi-VN') + "₫";
    }

    // Lắng nghe sự kiện thay đổi khi khách click chọn các hình thức vận chuyển
    shippingRadios.forEach(radio => {
        radio.addEventListener("change", updateCheckout);
    });

    // Chạy lần đầu khi tải trang
    updateCheckout();
});
</script>


        </div>
    </div>



