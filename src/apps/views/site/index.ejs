        <div class="max-w-4xl mx-auto w-full text-center lg:text-left space-y-4 sm:space-y-6">
        <%-item.content%>
        </div>
      </div>
          <% } %>


      <!-- Mũi tên điều hướng Trái / Phải -->
      <button onclick="prevSlide()" aria-label="Slide trước"
        class="absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 z-30 bg-black/40 hover:bg-blue-600 text-white w-10 h-10 rounded-full flex items-center justify-center transition">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button onclick="nextSlide()" aria-label="Slide sau"
        class="absolute right-3 sm:right-5 top-1/2 -translate-y-1/2 z-30 bg-black/40 hover:bg-blue-600 text-white w-10 h-10 rounded-full flex items-center justify-center transition">
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <!-- Slider Dots Indicators -->
     <!-- Slider Dots Indicators -->
        <div class="flex justify-center space-x-2 absolute bottom-4 left-0 right-0 z-30">
            <% banner.forEach((_, index) => { %>
            <button onclick="currentSlide(<%= index %>)"
                class="slider-dot <%= index === 0 ? 'w-6 sm:w-8 bg-blue-600' : 'w-2 bg-slate-600 hover:bg-slate-400' %> h-2 rounded-full transition-all"></button>
            <% }) %>
        </div>
    </div>
  </section>

  <!-- JavaScript Xử lý hiệu ứng trượt từ phải sang trái -->
  <script>
    let currentSlideIndex = 0;
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.slider-dot');
    let slideInterval;

    function showSlide(index, direction = 'next') {
      slides.forEach((slide, i) => {
        slide.classList.remove('opacity-100', 'opacity-0', 'translate-x-0', 'translate-x-full', '-translate-x-full', 'z-10', 'z-0');

        if (i === index) {
          slide.classList.add('opacity-100', 'translate-x-0', 'z-10');
        } else {
          slide.classList.add('opacity-0', 'z-0');
          if (direction === 'next') {
            if (i < index) {
              slide.classList.add('-translate-x-full');
            } else {
              slide.classList.add('translate-x-full');
            }
          } else {
            if (i > index) {
              slide.classList.add('translate-x-full');
            } else {
              slide.classList.add('-translate-x-full');
            }
          }
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove('w-2', 'bg-slate-600');
          dot.classList.add('w-6', 'sm:w-8', 'bg-blue-600');
        } else {
          dot.classList.remove('w-6', 'sm:w-8', 'bg-blue-600');
          dot.classList.add('w-2', 'bg-slate-600');
        }
      });
    }

    function nextSlide() {
      let prevIndex = currentSlideIndex;
      currentSlideIndex = (currentSlideIndex + 1) % slides.length;
      showSlide(currentSlideIndex, 'next');
      resetTimer();
    }

    function prevSlide() {
      let prevIndex = currentSlideIndex;
      currentSlideIndex = (currentSlideIndex - 1 + slides.length) % slides.length;
      showSlide(currentSlideIndex, 'prev');
      resetTimer();
    }

    function currentSlide(index) {
      let direction = index > currentSlideIndex ? 'next' : 'prev';
      currentSlideIndex = index;
      showSlide(currentSlideIndex, direction);
      resetTimer();
    }

    // Tự động chuyển slide sau mỗi 5 giây
    function startTimer() {
      slideInterval = setInterval(() => {
        nextSlide();
      }, 5000);
    }

    function resetTimer() {
      clearInterval(slideInterval);
      startTimer();
    }

    if (slides.length > 0) {
      startTimer();
    }
  </script>


