  <!-- Hero Section Slider (Hiệu ứng cuộn từ phải sang trái + Mũi tên điều hướng + Dots) -->
  <section class="relative bg-slate-900 text-white overflow-hidden min-h-[550px] sm:min-h-[600px] lg:h-[650px]">
