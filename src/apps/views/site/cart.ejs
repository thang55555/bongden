                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
                padding: 12px;
                position: relative;
            }

            /* Style cho hai nút mũi tên trái/phải */
            .related-section .slider-arrow {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                z-index: 10;
                background-color: #ffffff;
                border: 1px solid #cbd5e1;
                color: #1e293b;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
                transition: all 0.2s ease;
            }

            .related-section .slider-arrow:hover {
                background-color: #2563eb;
                color: #ffffff;
                border-color: #2563eb;
            }

            .related-section .slider-arrow.left {
                left: -18px;
            }

            .related-section .slider-arrow.right {
                right: -18px;
            }

            .related-section .related-grid {
                cursor: grab;
                user-select: none;
                /* Tránh bị bôi đen chữ/ảnh khi đang kéo */
            }

            .related-section .related-grid.is-dragging {
                cursor: grabbing;
            }

            /* Thêm hiệu ứng chuyển động mượt mà cho thẻ sản phẩm */
            .related-section .product-card {
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

            /* Khi rê chuột vào (hover): zoom nhẹ lên và nổi bóng đậm hơn */
            .related-section .product-card:hover {
                transform: translateY(-5px) scale(1.02);
                /* Dịch chuyển lên trên một chút và phóng to 2% */
                box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
                z-index: 2;
                /* Đảm bảo thẻ đang zoom nằm đè lên các thẻ bên cạnh */
            }

            /* Thêm dấu chấm ngăn cách nhẹ giữa (98) và lượt xem nếu muốn tinh tế hơn */
            .card-rating span:first-of-type::after {
                content: "•";
                margin-left: 6px;
                color: #cbd5e1;
            }
        </style>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const cartMain = document.querySelector(".cart-main");
    const btnDeleteAll = document.querySelector(".btn-clear-cart");

    // Hàm định dạng số thành tiền tệ VN (Ví dụ: 96000 -> "96.000đ")
    function formatMoney(amount) {
        return amount.toLocaleString('vi-VN') + 'đ';
    }

    // Hàm lấy số tiền từ chuỗi (Ví dụ: "36.700đ" -> 36700)
    function parseMoney(text) {
        return parseInt(text.replace(/\D/g, '')) || 0;
    }

    // Cập nhật số lượng trên icon giỏ hàng ở Header
    function updateCartBadge(totalCount) {
        const badge = document.querySelector("a.relative .rounded-full") || document.getElementById("cart-badge-count");
        if (badge) {
            badge.textContent = totalCount;
        }
    }

    // Kiểm tra nếu giỏ hàng trống thì hiển thị giao diện trống
    function checkIfCartEmpty() {
        if (!cartMain) return;
        const remainingItems = cartMain.querySelectorAll(".cart-item");
        
        if (remainingItems.length === 0) {
            updateCartBadge(0);

            cartMain.innerHTML = `
                <div style="padding: 40px; text-align: center; color: #64748b;">
                    <p style="margin-bottom: 15px;">Giỏ hàng của bạn hiện đang trống.</p>
                    <a href="/" style="display: inline-block; background-color: #2563eb; color: #ffffff; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 500; transition: background 0.2s;">
                        Quay lại mua sắm
                    </a>
                </div>
            `;

            const actionsBar = document.querySelector(".cart-actions-bar");
            if (actionsBar) actionsBar.style.display = "none";

            const orderSummary = document.querySelector(".order-summary");
            if (orderSummary) orderSummary.style.display = "none";

            const commitBox = document.querySelector(".commit-box");
            if (commitBox) commitBox.style.display = "none";
        }
    }

    // HÀM CHÍNH: TÍNH TOÁN LẠI TỔNG TIỀN, FREESHIP VÀ CẬP NHẬT GIAO DIỆN
    function updateCartTotals() {
        if (!cartMain) return;
        
        let totalItemsCount = 0;
        let subtotal = 0;

        const cartItems = cartMain.querySelectorAll(".cart-item");

        cartItems.forEach(item => {
            const priceElem = item.querySelector(".item-price");
            const input = item.querySelector(".qty-input");
            const totalElem = item.querySelector(".item-total");

            if (priceElem && input && totalElem) {
                let price = parseMoney(priceElem.textContent);
                let qty = parseInt(input.value) || 1;

                let itemTotal = price * qty;
                totalElem.textContent = formatMoney(itemTotal);

                subtotal += itemTotal;
                totalItemsCount += qty;
            }
        });

        // 1. Cập nhật số lượng lên badge giỏ hàng
        updateCartBadge(totalItemsCount);

        // 2. Cập nhật tiêu đề Tạm tính & Số tiền tạm tính
        const summaryTitleCount = document.querySelector(".summary-row span:first-child");
     

        const summaryRows = document.querySelectorAll(".order-summary .summary-row");
        if (summaryRows.length >= 2) {
            const subtotalSpan = summaryRows[0].querySelector("span:last-child");
            if (subtotalSpan) subtotalSpan.textContent = formatMoney(subtotal);

            const discountSpan = summaryRows[1].querySelector("span:last-child");
            let currentDiscount = discountSpan ? parseMoney(discountSpan.textContent) : 0;

            let grandTotal = subtotal - currentDiscount;
            if (grandTotal < 0) grandTotal = 0;

            const grandTotalSpan = document.querySelector(".total-price");
            if (grandTotalSpan) grandTotalSpan.textContent = formatMoney(grandTotal);
        }

        // 3. XỬ LÝ LOGIC FREESHIP THEO THỜI GIAN THỰC (Mốc: 1.000.000đ)
        const freeShipMsg = document.querySelector(".free-ship-msg");
        const freeShipBadge = document.querySelector(".free-ship-badge");
        const targetAmount = 1000000;

        if (subtotal >= targetAmount) {
            // Đã đủ điều kiện miễn phí vận chuyển
            if (freeShipMsg) {
                freeShipMsg.style.display = "block";
                freeShipMsg.style.color = "#10B981";
                freeShipMsg.innerHTML = `<i class="fa-solid fa-circle-check"></i> Bạn được miễn phí vận chuyển`;
            }
            if (freeShipBadge) {
                freeShipBadge.textContent = "Miễn phí";
                freeShipBadge.style.color = "#10B981";
            }
        } else {
            // Chưa đủ, tính số tiền còn thiếu
            let missingAmount = targetAmount - subtotal;
            if (freeShipMsg) {
                freeShipMsg.style.display = "block";
                freeShipMsg.style.color = "#f59e0b";
                freeShipMsg.innerHTML = `<i class="fa-solid fa-truck"></i> Mua thêm <strong>${formatMoney(missingAmount)}</strong> để được miễn phí vận chuyển`;
            }
            if (freeShipBadge) {
                freeShipBadge.textContent = "30.000đ"; // Hoặc phí ship mặc định của bạn
                freeShipBadge.style.color = "#334155";
            }
        }
    }

    // --- LẮNG NGHE SỰ KIỆN TĂNG / GIẢM / NHẬP SỐ LƯỢNG ---
    const quantityBoxes = document.querySelectorAll(".quantity-box");
    quantityBoxes.forEach(box => {
        const btnMinus = box.querySelector("button:first-child");
        const btnPlus = box.querySelector("button:last-child");
        const input = box.querySelector(".qty-input");

        if (!input) return;

        if (btnMinus) {
            btnMinus.addEventListener("click", () => {
                let val = parseInt(input.value) || 1;
                if (val > 1) {
                    input.value = val - 1;
                    updateCartTotals();
                }
            });
        }

        if (btnPlus) {
            btnPlus.addEventListener("click", () => {
                let val = parseInt(input.value) || 1;
                input.value = val + 1;
                updateCartTotals();
            });
        }

        input.addEventListener("input", function () {
            let value = this.value.replace(/\D/g, '');
            if (value === "" || parseInt(value) < 1) {
                this.value = 1;
            } else {
                this.value = parseInt(value);
            }
            updateCartTotals();
        });
    });

    // --- SỰ KIỆN XÓA TỪNG SẢN PHẨM ---
    function bindDeleteEvents() {
        if (!cartMain) return;
        const currentItems = cartMain.querySelectorAll(".cart-item");
        currentItems.forEach(item => {
            const btnDelete = item.querySelector(".btn-delete");
            if (btnDelete) {
                btnDelete.onclick = function () {
                    item.remove();
                    updateCartTotals();
                    checkIfCartEmpty();
                };
            }
        });
    }
    bindDeleteEvents();

    // --- SỰ KIỆN XÓA TẤT CẢ GIỎ HÀNG ---
    if (btnDeleteAll && cartMain) {
        btnDeleteAll.addEventListener("click", () => {
            if (confirm("Bạn có chắc chắn muốn xóa tất cả sản phẩm trong giỏ hàng không?")) {
                const currentItems = cartMain.querySelectorAll(".cart-item");
                currentItems.forEach(item => item.remove());
                
                updateCartTotals();
                checkIfCartEmpty();

                // Gọi ngầm lên server xóa session (không làm load lại trang gây lỗi)
                fetch('/delete/cart', { method: 'GET' }).catch(err => console.log(err));
            }
        });
    }

    // Chạy khởi tạo tính toán lần đầu khi load trang
    updateCartTotals();
});
</script>

