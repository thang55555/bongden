                /* Ẩn thanh cuộn trên Firefox */
                padding: 10px 4px;
            }

            /* Ẩn thanh cuộn trên Chrome, Safari */
            .related-section .related-grid::-webkit-scrollbar {
                display: none;
            }

            /* Cố định kích thước thẻ sản phẩm để không bị bóp méo khi trượt */
            .related-section .product-card {
                flex: 0 0 220px;
