            <style>
                /* Ngăn trình duyệt cho phép kéo thả thẻ hình ảnh bên trong slider */
.product-card img {
    -webkit-user-drag: none; /* Cho Safari/Chrome */
    user-drag: none;
    pointer-events: none; /* Quan trọng: Cho phép click xuyên qua ảnh để nhận sự kiện của thẻ cha */
}
                .related-grid {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Ẩn scrollbar trên Firefox */
    -ms-overflow-style: none; /* Ẩn scrollbar trên IE/Edge */
    padding: 10px 0;
    cursor: grab; /* Hiển thị con trỏ bàn tay khi rê chuột */
}

/* Ẩn scrollbar trên Chrome/Safari/Opera */
.related-grid::-webkit-scrollbar {
    display: none;
}

/* Đảm bảo mỗi product-card có kích thước cố định để cuộn mượt */
.product-card {
    flex: 0 0 250px; /* Chỉnh độ rộng của card tùy ý bạn */
    scroll-snap-align: start;
}

.related-grid:active {
    cursor: grabbing; /* Đổi con trỏ khi đang nhấn giữ kéo */
}
            </style>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
    const sliderContainer = document.querySelector(".related-grid");
    const btnLeft = document.querySelector(".slider-arrow.left");
    const btnRight = document.querySelector(".slider-arrow.right");

    if (!sliderContainer) return;

    // 1. Xử lý sự kiện click nút bấm trái / phải
    const scrollAmount = 300; // Khoảng cách cuộn mỗi lần bấm (px)

    if (btnLeft) {
        btnLeft.addEventListener("click", () => {
            sliderContainer.scrollBy({ left: -scrollAmount, behavior: "smooth" });
        });
    }

    if (btnRight) {
        btnRight.addEventListener("click", () => {
            sliderContainer.scrollBy({ left: scrollAmount, behavior: "smooth" });
        });
    }

    // 2. Xử lý tính năng kéo chuột (Drag to scroll)
    let isDown = false;
    let startX;
    let scrollLeft;

    sliderContainer.addEventListener("mousedown", (e) => {
        isDown = true;
        sliderContainer.classList.add("active");
        startX = e.pageX - sliderContainer.offsetLeft;
        scrollLeft = sliderContainer.scrollLeft;
    });

    sliderContainer.addEventListener("mouseleave", () => {
        isDown = false;
        sliderContainer.classList.remove("active");
    });

    sliderContainer.addEventListener("mouseup", () => {
        isDown = false;
        sliderContainer.classList.remove("active");
    });

    sliderContainer.addEventListener("mousemove", (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - sliderContainer.offsetLeft;
        const walk = (x - startX) * 2; // Tốc độ kéo (nhân lên để nhanh hơn)
        sliderContainer.scrollLeft = scrollLeft - walk;
    });
});
            </script>
