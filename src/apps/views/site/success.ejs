<%- include("./layouts/head.ejs")%>


    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Breadcrumb -->
        <nav class="text-xs sm:text-sm text-slate-500 flex items-center space-x-2">
            <a href="/" class="hover:text-blue-600 transition">Trang chủ</a>
            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
            <a href="/lien-he" class="hover:text-blue-600 transition">Hỗ trợ</a>
            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
            <span class="text-slate-800 font-medium">Tư vấn</span>
        </nav>

        <!-- Main Card: Thành công -->
        <div
            class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-slate-100 relative overflow-hidden space-y-8">

            <!-- Phần thông báo thành công & Icon lớn -->
            <div class="flex flex-col items-center text-center space-y-4">
                <!-- Vòng tròn icon check kèm các chi tiết trang trí ngẫu nhiên -->
                <div class="relative w-28 h-28 sm:w-36 sm:h-36 flex items-center justify-center">
                    <!-- Các chấm trang trí xung quanh giống ảnh mẫu -->
                    <div class="absolute top-2 left-6 w-2 h-2 rounded-full bg-emerald-400"></div>
                    <div class="absolute top-6 right-8 w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
                    <div class="absolute bottom-6 left-4 w-2 h-2 rounded-full bg-blue-400"></div>
                    <div class="absolute bottom-2 right-12 w-2 h-2 rounded-full bg-indigo-400"></div>
                    <div class="absolute top-1/2 left-2 w-1.5 h-1.5 rounded-full bg-teal-400"></div>

                    <!-- Vòng tròn nền xanh lá -->
                    <div
                        class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-emerald-500/10 flex items-center justify-center relative">
                        <div
                            class="w-20 h-20 sm:w-26 sm:h-26 rounded-full bg-emerald-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/30">
                            <i class="fa-solid fa-check text-3xl sm:text-4xl"></i>
                        </div>
                    </div>
                </div>

                <div class="space-y-1">
                    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">CẢM ƠN BẠN!</h2>
                    <p class="text-base sm:text-lg font-semibold text-emerald-600">Yêu cầu tư vấn của bạn đã được gửi
                        thành công.</p>
                </div>
                <p class="text-xs sm:text-sm text-slate-500 max-w-md">Chúng tôi đã tiếp nhận thông tin và sẽ liên hệ với
                    bạn trong thời gian sớm nhất.</p>
            </div>

            <!-- 3 Khung thông tin ngang (Mã yêu cầu, Thời gian, Liên hệ) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                <!-- Mã yêu cầu -->
                <div class="bg-slate-50/70 rounded-2xl p-4 border border-slate-100 flex items-center space-x-3.5">
                    <div
                        class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-[11px] text-slate-400 font-medium">Mã yêu cầu tư vấn</p>
                        <div class="flex items-center space-x-1.5">
                            <span id="consult-code"
                                class="text-xs sm:text-sm font-bold text-slate-900 tracking-wide"><%=product.matuvan%></span>
                            <button onclick="
                const btn = this;
                const icon = btn.querySelector('i');
                navigator.clipboard.writeText(document.getElementById('consult-code').innerText);
                
                // Đổi sang icon check
                icon.className = 'fa-solid fa-check text-xs text-green-600';
                
                // Trả lại icon cũ sau 2 giây
                setTimeout(() => {
                    icon.className = 'fa-regular fa-copy text-xs';
                }, 2000);
            " class="text-blue-600 hover:text-blue-700 transition" title="Sao chép">
                                <i class="fa-regular fa-copy text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Thời gian phản hồi -->
                <div class="bg-slate-50/70 rounded-2xl p-4 border border-slate-100 flex items-center space-x-3.5">
                    <div
                        class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div>
                        <p class="text-[11px] text-slate-400 font-medium">Thời gian phản hồi dự kiến</p>
                        <p class="text-xs sm:text-sm font-bold text-slate-900">Trong vòng 30 phút</p>
                        <p class="text-[10px] text-slate-400">(Trong giờ hành chính)</p>
                    </div>
                </div>

                <!-- Liên hệ hỗ trợ -->
                <div class="bg-slate-50/70 rounded-2xl p-4 border border-slate-100 flex items-center space-x-3.5">
                    <div
                        class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <div>
                        <p class="text-[11px] text-slate-400 font-medium">Liên hệ hỗ trợ ngay</p>
                        <p class="text-xs sm:text-sm font-bold text-blue-600"><%=thongtintrang.sdt%></p>
                        <p class="text-[10px] text-slate-400">(8:00 - 22:00, T2 - CN)</p>
                    </div>
                </div>
            </div>

            <!-- Banner thông báo email -->
            <div class="bg-emerald-50/50 rounded-2xl p-4 border border-emerald-100/60 flex items-start space-x-3.5">
                <div
                    class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <i class="fa-regular fa-envelope text-sm"></i>
                </div>
                <div class="text-xs sm:text-sm space-y-0.5">
                    <p class="text-slate-600">Thông tin chi tiết đã được gửi đến email của bạn:</p>
                    <p class="font-bold text-slate-900"><%=product.mail%></p>
                    <p class="text-[11px] text-slate-400 pt-0.5">Vui lòng kiểm tra hộp thư (Inbox) hoặc thư rác (Spam)
                        nếu không thấy email.</p>
                </div>
            </div>

            <!-- Hai nút hành động -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                <a href="/"
                    class="w-full sm:w-auto px-8 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition shadow-sm shadow-blue-500/20">
                    <i class="fa-solid fa-house text-xs"></i>
                    <span>VỀ TRANG CHỦ</span>
                </a>
                <a href="/san-pham"
                    class="w-full sm:w-auto px-8 py-3 rounded-xl bg-white hover:bg-slate-50 text-blue-600 border border-blue-200 font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition">
                    <i class="fa-solid fa-box-open text-xs"></i>
                    <span>XEM SẢN PHẨM</span>
                </a>
            </div>

        </div>

        <!-- Secondary Card: Thông tin chi tiết yêu cầu & Tệp đính kèm -->
        <div
            class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100 grid grid-cols-1 lg:grid-cols-12 gap-8">

            <!-- Cột trái: Thông tin yêu cầu (chiếm 7 phần) -->
            <div class="lg:col-span-7 space-y-4">
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 uppercase tracking-wider">THÔNG TIN YÊU CẦU TƯ
                    VẤN CỦA BẠN</h3>

                <div class="text-xs sm:text-sm space-y-2.5 text-slate-600">
                    <div class="grid grid-cols-12 gap-2">
                        <span class="col-span-4 sm:col-span-3 text-slate-400 font-medium">Họ và tên</span>
                        <span class="col-span-8 sm:col-span-9 font-semibold text-slate-900">: <%=product.name%></span>
                    </div>
                    <div class="grid grid-cols-12 gap-2">
                        <span class="col-span-4 sm:col-span-3 text-slate-400 font-medium">Số điện thoại</span>
                        <span class="col-span-8 sm:col-span-9 font-semibold text-slate-900">: <%=product.sdt%></span>
                    </div>
                    <div class="grid grid-cols-12 gap-2">
                        <span class="col-span-4 sm:col-span-3 text-slate-400 font-medium">Email</span>
                        <span class="col-span-8 sm:col-span-9 font-semibold text-slate-900">:
                            <%=product.email%></span>
                    </div>
                    <div class="grid grid-cols-12 gap-2">
                        <span class="col-span-4 sm:col-span-3 text-slate-400 font-medium">Loại khách hàng</span>
                        <span class="col-span-8 sm:col-span-9 font-semibold text-slate-900">: <%=product.khachhang%></span>
                    </div>
                    <div class="grid grid-cols-12 gap-2">
                        <span class="col-span-4 sm:col-span-3 text-slate-400 font-medium">Khu vực</span>
                        <span class="col-span-8 sm:col-span-9 font-semibold text-slate-900">: <%=product.diachi%></span>
                    </div>
                    <div class="grid grid-cols-12 gap-2">
                        <span class="col-span-4 sm:col-span-3 text-slate-400 font-medium">Nhu cầu tư vấn</span>
                        <span class="col-span-8 sm:col-span-9 font-semibold text-slate-900">: <%=product.nhucau%></span>
                    </div>
                    <div class="grid grid-cols-12 gap-2">
                        <span class="col-span-4 sm:col-span-3 text-slate-400 font-medium">Nội dung yêu cầu</span>
                        <span class="col-span-8 sm:col-span-9 font-semibold text-slate-900 leading-relaxed">: <%=product.noidung%></span>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Tệp đính kèm (chiếm 5 phần) -->
            <div class="lg:col-span-5 space-y-4 lg:border-l lg:border-slate-100 lg:pl-8">
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 uppercase tracking-wider">Tệp đính kèm</h3>

                <div class="space-y-3">
                    <!-- File 1 -->
                    <div
                        class="flex items-center space-x-3 p-2.5 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition">
                        <div
                            class="w-12 h-10 rounded-lg bg-slate-200 overflow-hidden flex-shrink-0 flex items-center justify-center text-slate-400">
                            <!-- Giả lập thumbnail hình ảnh -->
                            <i class="fa-regular fa-image text-base"></i>
                        </div>
                        <div class="overflow-hidden text-xs">
                            <p class="font-bold text-slate-900 truncate"><%=product.images%></p>
                            <p class="text-slate-400 text-[11px]"><%=product.sizeInMB%> MB</p>
                        </div>
                    </div>

                   
                </div>
            </div>

        </div>

        <!-- Footer Features Bar (Miễn phí vận chuyển, Bảo hành, Đổi trả, Hỗ trợ) -->
        <div
            class="bg-white rounded-3xl p-4 sm:p-6 shadow-sm border border-slate-100 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- Item 1 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Miễn phí vận chuyển</h4>
                    <p class="text-[11px] text-slate-500">Cho đơn hàng từ 1.000.000đ</p>
                </div>
            </div>

            <!-- Item 2 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Bảo hành chính hãng</h4>
                    <p class="text-[11px] text-slate-500">Lên đến 3 năm</p>
                </div>
            </div>

            <!-- Item 3 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-rotate"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Đổi trả dễ dàng</h4>
                    <p class="text-[11px] text-slate-500">Trong vòng 7 ngày</p>
                </div>
            </div>

            <!-- Item 4 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Hỗ trợ kỹ thuật 24/7</h4>
                    <p class="text-[11px] text-slate-500">Tư vấn và giải đáp nhanh chóng</p>
                </div>
            </div>

        </div>

    </div>



        <%- include("./layouts/footer.ejs")%>