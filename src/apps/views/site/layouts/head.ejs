        <a href="/category-du-an" class="hover:text-blue-600 transition">DỰ ÁN</a>
        <a href="/category-tin-tuc" class="hover:text-blue-600 transition">TIN TỨC</a>
        <a href="/lien-he" class="hover:text-blue-600 transition">LIÊN HỆ</a>
