          <!-- Mega Menu Dropdown -->
          <div
            class="absolute top-full left-0 w-[650px] bg-white shadow-xl rounded-xl border border-slate-100 hidden group-hover:block p-6 transition-all">

            <!-- Khung chứa 2 cột chính -->
            <div class="grid grid-cols-2 gap-4"
              x-data="{ activeTab: '<%= menu1 && menu1.length > 0 ? menu1[0]._id : "" %>' }">

              <!-- CỘT BÊN TRÁI: Danh mục cấp 1 (Menu1) -->
              <div class="space-y-1">
                <% menu1.forEach((item, index)=> { %>
                  <a href="/category?danh-muc=<%= item.slug %>&id=<%= item._id %>" @mouseenter="activeTab = '<%= item._id %>'"
                    :class="activeTab === '<%= item._id %>' ? 'bg-blue-50 text-blue-600 font-medium' : 'text-slate-700 hover:bg-slate-50'"
                    class="flex items-center justify-between p-2.5 rounded-lg transition">
                    <div class="flex items-center gap-3">
                      <!-- Bạn có thể thay icon tùy ý hoặc dùng icon mặc định từ DB nếu có -->
                      <%- item.icon %>
                      <%= item.name %>
                    </div>
                    <!-- Mũi tên hiển thị khi mục này đang được chọn -->
                    <i class="fa-solid fa-chevron-right text-xs transition-transform"
                      :class="activeTab === '<%= item._id %>' ? 'opacity-150 translate-x-0.5' : 'opacity-30'"></i>
                  </a>
                  <% }) %>
              </div>

              <!-- CỘT BÊN PHẢI: Menu con cấp 2 tương ứng (Menu2) -->
              <div class="space-y-1">
                <% menu1.forEach((item)=> { %>
                  <!-- Mỗi tab cấp 1 sẽ tương ứng với một khối x-show kiểm tra _id -->
                  <div x-show="activeTab === '<%= item._id %>'" class="space-y-1" <%=item===menu1[0] ? ''
                    : 'style="display: none;"' %>>
                    <% // Lọc các menu2 có chứa danhmuc_id trùng với item._id của menu1 const
                      subMenus=menu2.filter(sub=> {
                      if (!sub.danhmuc_id) return false;
                      // Vì danhmuc_id ở schema là một Mảng (Array) các ObjectId
                      return sub.danhmuc_id.some(id => id.toString() === item._id.toString());
                      });
                      %>

                      <% if (subMenus.length> 0) { %>
                        <% subMenus.forEach(sub=> { %>
                          <a href="/category?danh-muc=<%= sub.slug %>&id=<%= sub._id %>"
                            class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-blue-50 text-slate-700 hover:text-blue-600 transition">
                            <i class="fa-solid fa-circle text-xs text-blue-600 w-6"></i>
                            <%= sub.name %>
                          </a>
                          <% }) %>
                            <% } else { %>
                              <div class="p-2.5 text-slate-400 text-sm italic">Đang cập nhật danh mục...</div>
                              <% } %>
                  </div>
                  <% }) %>
              </div>

            </div>

            <!-- Dòng Xem tất cả sản phẩm ở dưới cùng -->
            <div class="border-t border-slate-100 pt-3 mt-4">
              <a href="/san-pham"
