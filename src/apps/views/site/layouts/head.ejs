      <!-- Search & Cart -->
      <div class="flex items-center space-x-3">
        <!-- Ô tìm kiếm trên desktop -->
<form action="/search" method="GET" class="relative hidden sm:block w-48 md:w-64">
  <input type="text" name="keyword" id="search-input" placeholder="Tìm kiếm sản phẩm..." autocomplete="off"
    class="w-full bg-slate-100 text-sm text-slate-800 rounded-full py-2.5 pl-4 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-500 border border-transparent">
  
  <button type="submit" class="absolute right-1.5 top-1/2 -translate-y-1/2 p-2 text-slate-400 hover:text-blue-600 flex items-center justify-center rounded-full" aria-label="Tìm kiếm">
    <i class="fa-solid fa-magnifying-glass text-sm"></i>
  </button>

  <!-- Khung hiển thị gợi ý kết quả -->
  <div id="search-suggestions" class="absolute left-0 right-0 mt-2 bg-white border border-slate-200 rounded-lg shadow-lg hidden z-50 max-h-60 overflow-y-auto">
    <!-- Dữ liệu gợi ý sẽ được chèn vào đây bằng JavaScript -->
  </div>
</form>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const searchInput = document.getElementById('search-input');
  const suggestionsBox = document.getElementById('search-suggestions');
  
  if (searchInput && suggestionsBox) {
    let timeoutId = null;

    searchInput.addEventListener('input', function() {
      const keyword = this.value.trim();

      // Xóa timeout cũ để tránh gọi API liên tục mỗi khi gõ phím (Debounce)
      clearTimeout(timeoutId);

      if (keyword.length === 0) {
        suggestionsBox.innerHTML = '';
        suggestionsBox.classList.add('hidden');
        return;
      }

      // Đợi 300ms sau khi người dùng ngừng gõ mới gọi API
      timeoutId = setTimeout(() => {
        fetch(`/api/search-suggestions?keyword=${encodeURIComponent(keyword)}`)
          .then(response => response.json())
          .then(data => {
            if (data.length > 0) {
              let html = '';
              data.forEach(item => {
                // Lấy ảnh đầu tiên hoặc ảnh mặc định
                let imgSrc = (item.image && item.image.length > 0) ? item.image[0].images : 'default.webp';
                
                html += `
                  <a href="/product?san-pham=${item.slug}&id=${item._id}" class="flex items-center gap-3 p-2 hover:bg-slate-50 transition border-b border-slate-100 last:border-none">
                    <img src="../site/images/update/${imgSrc}" alt="${item.name}" class=" h-10 object-cover rounded">
                    <div class="flex-1 min-w-0">
                      <p class="text-xs font-medium text-slate-800 truncate">${item.name}</p>
                      <p class="text-xs text-blue-600 font-semibold">${Number(item.sale).toLocaleString()} đ</p>
                    </div>
                  </a>
                `;
              });
              suggestionsBox.innerHTML = html;
              suggestionsBox.classList.remove('hidden');
            } else {
              suggestionsBox.innerHTML = `<div class="p-3 text-xs text-slate-500 text-center">Không tìm thấy sản phẩm phù hợp</div>`;
              suggestionsBox.classList.remove('hidden');
            }
          })
          .catch(err => console.error(err));
      }, 300);
    });

    // Ẩn khung gợi ý khi click ra ngoài ô tìm kiếm
    document.addEventListener('click', function(e) { 
      if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
        suggestionsBox.classList.add('hidden');
      }
    });
  }
});
</script>
