    <!-- JavaScript cập nhật bổ sung sự kiện bấm mở danh mục sản phẩm trên mobile -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  // Xử lý mở/đóng danh mục Sản phẩm trên mobile
  const mobileProductToggle = document.getElementById('mobile-product-toggle');
  const mobileProductDropdown = document.getElementById('mobile-product-dropdown');
  const productChevron = document.getElementById('product-chevron');

  if (mobileProductToggle && mobileProductDropdown && productChevron) {
    mobileProductToggle.addEventListener('click', () => {
      mobileProductDropdown.classList.toggle('hidden');
      productChevron.classList.toggle('rotate-180');
    });
  }
});
</script>
  </header>

  <!-- JavaScript xử lý Menu Mobile (Đổi icon 3 gạch thành dấu X) và Slider -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  if (mobileMenuButton && mobileMenu && menuIcon) {
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      // Chuyển đổi giữa icon 3 gạch (fa-bars) và dấu X (fa-xmark)
      if (mobileMenu.classList.contains('hidden')) {
        menuIcon.classList.remove('fa-xmark');
        menuIcon.classList.add('fa-bars');
      } else {
        menuIcon.classList.remove('fa-bars');
        menuIcon.classList.add('fa-xmark');
      }
    });
  }
});
</script>