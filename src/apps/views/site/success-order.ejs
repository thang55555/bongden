
<%- include("./layouts/head.ejs")%>


    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Breadcrumb -->
        <nav class="text-xs sm:text-sm text-slate-500 flex items-center space-x-2">
            <a href="/" class="hover:text-blue-600 transition">Trang chủ</a>
            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
            <span class="text-slate-800 font-medium">Đặt hàng</span>
        </nav>

        <!-- Main Card: Đặt hàng thành công & Hỗ trợ -->
        <div
            class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

            <!-- Phần trái: Thông báo thành công (chiếm 7 phần) -->
            <div class="lg:col-span-7 space-y-6">
                <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6">
                    <!-- Vòng tròn icon check kèm các chi tiết trang trí -->
                    <div class="relative w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center flex-shrink-0">
                        <div class="absolute top-1 left-2 w-2 h-2 rounded-full bg-emerald-400"></div>
                        <div class="absolute top-4 right-2 w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
                        <div class="absolute bottom-4 left-1 w-2 h-2 rounded-full bg-blue-400"></div>
                        <div class="absolute bottom-1 right-6 w-2 h-2 rounded-full bg-indigo-400"></div>
                        <div class="absolute top-1/2 left-0 w-1.5 h-1.5 rounded-full bg-teal-400"></div>

                        <!-- Vòng tròn nền xanh lá -->
                        <div
                            class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-emerald-500/10 flex items-center justify-center relative">
                            <div
                                class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-emerald-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/30">
                                <i class="fa-solid fa-check text-2xl sm:text-3xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">ĐẶT HÀNG THÀNH
                            CÔNG!</h2>
                        <p class="text-xs sm:text-sm text-slate-600">
                            Cảm ơn bạn đã tin tưởng và mua hàng tại <span class="font-semibold text-slate-900">HTC
                                Lighting</span>.<br>
                            Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.
                        </p>
                    </div>
                </div>

                <!-- Mã đơn hàng box -->
                <div
                    class="bg-emerald-50/50 rounded-2xl p-4 border border-emerald-100/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="space-y-0.5">
                        <p class="text-[11px] text-slate-500 font-medium">Mã đơn hàng</p>
                        <div class="flex items-center space-x-2">
                            <!-- Thêm id="order-code" để lấy dữ liệu -->
                            <span id="order-code"
                                class="text-sm sm:text-base font-bold text-emerald-700 tracking-wide"><%=saveOrder.madonhang%></span>

                            <!-- Viết trực tiếp JS vào onclick -->
                            <button onclick="
                const btn = this;
                const icon = btn.querySelector('i');
                navigator.clipboard.writeText(document.getElementById('order-code').innerText);
                
                // Đổi sang icon check
                icon.className = 'fa-solid fa-check text-sm text-green-600';
                
                // Trả lại icon cũ sau 2 giây
                setTimeout(() => {
                    icon.className = 'fa-regular fa-copy text-sm';
                }, 2000);
            " class="text-blue-600 hover:text-blue-700 transition" title="Sao chép">
                                <i class="fa-regular fa-copy text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Thông báo email và số điện thoại -->
                <p class="text-xs text-slate-500">
                    Chúng tôi đã gửi thông tin đơn hàng đến email <span
                        class="font-semibold text-slate-900"><%=saveOrder.email%></span> và số điện thoại <span
                        class="font-semibold text-slate-900"><%=saveOrder.sdt%></span>
                </p>
            </div>

            <!-- Phần phải: Bạn cần hỗ trợ? (chiếm 5 phần, có border trái trên màn hình lớn) -->
            <div
                class="lg:col-span-5 bg-slate-50/70 rounded-2xl p-6 border border-slate-100 space-y-4 lg:border-l lg:border-slate-100 lg:pl-8 lg:bg-transparent lg:border-0">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Bạn cần hỗ trợ?</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Đội ngũ HTC luôn sẵn sàng hỗ trợ bạn</p>
                </div>

                <div class="space-y-3 text-xs sm:text-sm text-slate-600">
                    <div class="flex items-center space-x-3">
                        <i class="fa-solid fa-phone text-blue-600 text-sm w-4 text-center"></i>
                        <span>Hotline: <strong class="text-slate-900"><%=thongtintrang.sdt%></strong> (8:00 - 22:00, T2 - CN)</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <i class="fa-regular fa-envelope text-blue-600 text-sm w-4 text-center"></i>
                        <span>Email: <strong class="text-slate-900"><%=thongtintrang.email%></strong></span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <i class="fa-regular fa-comment-dots text-blue-600 text-sm w-4 text-center"></i>
                        <span>Chat trực tuyến: <a href="/lien-he" class="text-blue-600 font-semibold hover:underline">Hỗ trợ
                                ngay</a></span>
                    </div>
                </div>

                <div class="pt-2">
                    <a href="/san-pham"
                        class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition shadow-sm shadow-blue-500/20">
                        <span>TIẾP TỤC MUA SẮM</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>

        </div>

        <!-- Chi tiết đơn hàng (Thông tin đơn hàng, Địa chỉ giao hàng, Tóm tắt đơn hàng) -->
        <div
            class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100 grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-12">
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-6">CHI TIẾT ĐƠN HÀNG</h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-xs sm:text-sm text-slate-600">

                    <!-- Cột 1: Thông tin đơn hàng -->
                    <div class="space-y-3">
                        <div class="flex items-center space-x-2 text-slate-900 font-semibold mb-4">
                            <i class="fa-solid fa-file-lines text-blue-600"></i>
                            <span>Thông tin đơn hàng</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Ngày đặt hàng:</span>
                            <span class="font-medium text-slate-900">
                                <% 
  const d = new Date(saveOrder.createdAt);
  
  const ngay = String(d.getDate()).padStart(2, '0');
  const thang = String(d.getMonth() + 1).padStart(2, '0');
  const nam = d.getFullYear();
  const gio = String(d.getHours()).padStart(2, '0');
  const phut = String(d.getMinutes()).padStart(2, '0');
  
  const timeFormatted = `${ngay}/${thang}/${nam} - ${gio}:${phut}`;
%>

<span><%= timeFormatted %></span>
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Hình thức vận chuyển:</span>
                            <span class="font-medium text-slate-900 text-right"><%=saveOrder.vanchuyen%></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Hình thức thanh toán:</span>
                            <span class="font-medium text-slate-900 text-right"><%=saveOrder.thanhtoan%></span>
                        </div>
                    </div>

                    <!-- Cột 2: Địa chỉ giao hàng -->
                    <div class="space-y-3">
                        <div class="flex items-center space-x-2 text-slate-900 font-semibold mb-4">
                            <i class="fa-solid fa-location-dot text-blue-600"></i>
                            <span>Địa chỉ giao hàng</span>
                        </div>
                        <div>
                            <p class="font-semibold text-slate-900"><%=saveOrder.name%> - <%=saveOrder.sdt%></p>
                            <p class="text-slate-600 mt-1"><%=saveOrder.diachigiao%>
                            </p>
                        </div>
                        <div class="pt-1">
                            <span class="text-slate-400">Ghi chú: </span>
                            <span class="text-slate-600"><%=saveOrder.note%></span>
                        </div>
                    </div>

                    <!-- Cột 3: Tóm tắt đơn hàng -->
                    <div class="space-y-3 lg:border-l lg:border-slate-100 lg:pl-8">
                        <div class="text-slate-900 font-semibold mb-4">
                            <span>Tóm tắt đơn hàng</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Tạm tính (<%=cart.length%> sản phẩm)</span>
                            <span class="font-medium text-slate-900"><%= Number(totalPrice).toLocaleString('vi-VN') %>₫</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Phí vận chuyển</span>
                            <span class="<%= saveOrder.ship === 0 ? 'font-medium text-emerald-600' : '' %>">
    <%= saveOrder.ship === 0 ? 'Miễn phí' : Number(saveOrder.ship).toLocaleString('vi-VN') + 'đ' %>
</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Giảm giá</span>
                            <span class="font-medium text-slate-900">0đ</span>
                        </div>
                        <div class="pt-3 border-t border-slate-100 flex justify-between items-center">
                            <span class="font-bold text-slate-900">TỔNG CỘNG</span>
                            <div class="text-right">
                                <div class="text-lg font-bold text-blue-600"><%= Number(finalTotalPrice).toLocaleString('vi-VN') %>₫</div>
                                <div class="text-[10px] text-slate-400">(Đã bao gồm VAT)</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- Sản phẩm có thể bạn cần (Slider/Carousel Section) -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100 space-y-6 relative">
            <h3 class="text-center text-sm sm:text-base font-bold text-slate-900 uppercase tracking-wider">SẢN PHẨM CÓ
                THỂ BẠN CẦN</h3>

            <!-- Nút điều hướng trái -->
            <button onclick="document.getElementById('product-slider').scrollBy({ left: -280, behavior: 'smooth' })"
                class="absolute -left-3 sm:-left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-md border border-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-50 transition z-20">
                <i class="fa-solid fa-chevron-left text-xs"></i>
            </button>

            <!-- Danh sách sản phẩm dạng Slider có thể kéo vuốt ngang -->
            <div id="product-slider"
                class="flex gap-4 overflow-x-auto scroll-smooth pb-4 pt-1 px-1 no-scrollbar cursor-grab active:cursor-grabbing">

                <!-- Sản phẩm  -->
                 <%for(item of products){%>
                <div
                    class="min-w-[200px] sm:min-w-[220px] lg:min-w-[20%] flex-1 bg-slate-50/50 rounded-2xl p-4 border border-slate-100 flex flex-col justify-between hover:shadow-md transition group">
                    <div class="space-y-3">
                        <div
                            class="w-full h-32 flex items-center justify-center bg-white rounded-xl p-2 relative overflow-hidden">
            <% 
            let price = Number(item.price);
            let sale = Number(item.sale);
            let discountPercent = (price > sale && price > 0) ? Math.round(((price - sale) / price) * 100) : 0;
        %>

        <% if (discountPercent > 0) { %>
                            <span
                                class="absolute top-2 left-2 bg-rose-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full z-15 shadow-sm">-<%= discountPercent %>%</span>
                                 <% } %>
  <img src="../site/images/update/<%= item.image && item.image.length > 0 ? item.image[0].images : '' %>"
    alt="<%=item.slug%>"
    class="max-h-full object-contain group-hover:scale-105 transition duration-300 pointer-events-none select-none">
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-slate-900 line-clamp-1"><%= item.name %></h4>
                            <p class="text-[11px] text-slate-400 mt-0.5">Ánh sáng trắng (6500K)</p>
                            <div class="flex items-center justify-between mt-2 text-[10px] text-slate-400">
                                <div class="flex items-center space-x-1 mt-1.5 text-[10px] text-amber-400">
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <span class="text-slate-400 ml-1">(98) <span><i
                                                class="fa-regular fa-eye mr-1"></i><%= item.view || 0 %> lượt xem</span></span>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="flex items-end justify-between mt-4 pt-2 border-t border-slate-100">
                        <div>
                            <span class="text-[10px] text-slate-400 line-through block"><%= Number(item.price).toLocaleString('vi-VN') %>₫</span>
                            <span class="text-xs sm:text-sm font-bold text-blue-600"><%= Number(item.sale).toLocaleString('vi-VN') %>₫</span>
                        </div>

            <!-- Biến nút bấm thành form nhỏ để gửi AJAX -->
<form action="/cart/<%= item._id %>" method="POST" class="ajax-cart-form" style="display: inline;">
    <input type="hidden" name="qty" value="1">
    <button type="button" class="card-cart-btn btn-add-ajax w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center hover:bg-blue-600 hover:text-white transition group/btn " aria-label="Thêm vào giỏ hàng">
        <i class="fa-solid fa-cart-shopping text-xs transition-transform duration-500 group-hover/btn:rotate-[360deg]"></i>
    </button>
</form>


                    </div>
                </div>
                <%}%>

            </div>

            <!-- Nút điều hướng phải -->
            <button onclick="document.getElementById('product-slider').scrollBy({ left: 280, behavior: 'smooth' })"
                class="absolute -right-3 sm:-right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-md border border-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-50 transition z-20">
                <i class="fa-solid fa-chevron-right text-xs"></i>
            </button>
        </div>

        <!-- Đoạn script hỗ trợ thao tác kéo trượt chuột trái/phải -->
        <script>
            const slider = document.getElementById('product-slider');
            let isDown = false;
            let startX;
            let scrollLeft;

            slider.addEventListener('mousedown', (e) => {
                isDown = true;
                startX = e.pageX - slider.offsetLeft;
                scrollLeft = slider.scrollLeft;
            });
            slider.addEventListener('mouseleave', () => { isDown = false; });
            slider.addEventListener('mouseup', () => { isDown = false; });
            slider.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - slider.offsetLeft;
                const walk = (x - startX) * 2;
                slider.scrollLeft = scrollLeft - walk;
            });
        </script>

        <style>
            
            /* Ẩn thanh cuộn mặc định */
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            /* Ngăn chặn bôi đen văn bản khi kéo chuột */
            #product-slider {
                -webkit-user-select: none;
                /* Safari */
                -moz-user-select: none;
                /* Firefox */
                -ms-user-select: none;
                /* IE/Edge */
                user-select: none;
                /* Standard */
            }
        </style>



        <!-- Footer Features Bar -->
        <div
            class="bg-white rounded-3xl p-4 sm:p-6 shadow-sm border border-slate-100 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- Item 1 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Miễn phí vận chuyển</h4>
                    <p class="text-[11px] text-slate-500">Cho đơn hàng từ 1.000.000đ</p>
                </div>
            </div>

            <!-- Item 2 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Bảo hành chính hãng</h4>
                    <p class="text-[11px] text-slate-500">Lên đến 3 năm</p>
                </div>
            </div>

            <!-- Item 3 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-rotate"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Đổi trả dễ dàng</h4>
                    <p class="text-[11px] text-slate-500">Trong vòng 7 ngày</p>
                </div>
            </div>

            <!-- Item 4 -->
            <div class="flex items-center space-x-3.5 p-2">
                <div
                    class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-lg">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-900">Hỗ trợ kỹ thuật 24/7</h4>
                    <p class="text-[11px] text-slate-500">Tư vấn và giải đáp nhanh chóng</p>
                </div>
            </div>

        </div>

    </div>





    <%- include("./layouts/footer.ejs")%>