<select onchange="handleSortChange(this)"
    class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs font-medium text-slate-700 focus:outline-none focus:border-blue-500 appearance-none pr-8 cursor-pointer">
    <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
    <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Cũ nhất</option>
    <option value="views" <%= sort === 'views' ? 'selected' : '' %>>Xem nhiều nhất</option>
</select>

<script>
function handleSortChange(selectElement) {
    const sortValue = selectElement.value;
    
    // Lấy URL hiện tại trên trình duyệt
    const url = new URL(window.location.href);
    
    // Thêm hoặc cập nhật tham số 'sort' vào URL
    url.searchParams.set('sort', sortValue);
    
    // Reset lại page về 1 mỗi khi thay đổi bộ lọc sắp xếp
    url.searchParams.set('page', '1');
    
    // Chuyển hướng trình duyệt đến URL mới
    window.location.href = url.toString();
}
</script>
                                <i
                                    class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 pointer-events-none"></i>
                            </div>
