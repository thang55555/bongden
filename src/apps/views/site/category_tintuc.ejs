                    <!-- Lưới danh sách bài viết (6 bài) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                         <% for(item of products){%>
                        <!-- Bài viết -->
                            <a href="/tin-tuc?slug=<%=item.slug%>&id=<%=item._id%>">
                        <div
                            class="bg-white rounded-2xl border border-slate-100 overflow-hidden flex flex-col justify-between hover:shadow-md transition group">
                            <div>
                                <div class="w-full h-48 bg-slate-100 overflow-hidden relative flex items-center justify-center ">
                                    <img src="../site/images/update/<%=item.images%>" alt="<%=item.slug%>" 
                                    class="h-full object-cover group-hover:scale-105 transition duration-300">
                                </div>
                                <div class="p-5 space-y-2.5">
                                    <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block"><%=item.menutintuc_id.name%></span>
                                    <h3
                                        class="text-sm sm:text-base font-bold text-slate-900 leading-snug group-hover:text-blue-600 transition line-clamp-2">
                                       <%=item.name%></h3>
<% 
    // 1. Lấy nội dung từ mảng hoặc chuỗi
    let rawContent = Array.isArray(item.content) ? item.content.join('') : (item.content || '');
    
    // 2. Xóa các thẻ HTML (bao gồm thẻ <img>, <video>,...) và các khoảng trắng thừa
    let plainText = String(rawContent).replace(/<[^>]*>/g, '').trim();
    
    // 3. Giải mã các ký tự tiếng Việt bị mã hóa (ví dụ: C&ocirc;ng -> Công)
    // Nếu bạn đã cài thư viện 'he' (npm install he), hãy dùng he.decode(plainText). 
    // Nếu không muốn cài thêm thư viện, có thể dùng đoạn mã xử lý thay thế bên dưới hoặc cấu hình Controller.
    let decodedText = plainText
        .replace(/&ocirc;/g, 'ô').replace(/&agrave;/g, 'à').replace(/&aacute;/g, 'á')
        .replace(/&eacute;/g, 'é').replace(/&egrave;/g, 'è').replace(/&iacute;/g, 'í')
        .replace(/&ì/g, 'ì').replace(/&oacute;/g, 'ó').replace(/&ograve;/g, 'ò')
        .replace(/&uacute;/g, 'ú').replace(/&ugrave;/g, 'ù').replace(/&Yý;/g, 'ý')
        .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');

    // 4. Cắt lấy 100 ký tự đầu tiên
    let shortText = decodedText.length > 100 ? decodedText.substring(0, 100) + '...' : decodedText;
%>

<p class="text-slate-600 text-xs leading-relaxed"><%= shortText %></p>
                                </div>
                            </div>
                            <div
                                class="px-5 pb-5 pt-2 flex items-center justify-between text-[11px] text-slate-400 border-t border-slate-50">
                                <span><i class="fa-regular fa-calendar mr-1.5"></i><%= new Date(item.createdAt).toLocaleDateString('vi-VN') %></span>
                                <span><i class="fa-regular fa-eye mr-1.5"></i><%=item.view || 0 %> lượt xem</span>
                            </div>
                        </div>
                        </a>
                         <%}%>

                    </div>

                    <!-- Phân trang (Pagination) -->
<!-- Phân trang (Pagination) -->
<% if (totalPages > 1) { %>
    <div class="flex items-center justify-center space-x-2 pt-4 pb-2" id="pagination-container">
        
        <!-- Nút Previous -->
        <a href="#" data-page="<%= currentPage - 1 %>" 
           class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-50 transition text-xs <%= currentPage === 1 ? 'pointer-events-none opacity-50' : '' %>">
            <i class="fa-solid fa-chevron-left"></i>
        </a>

        <!-- Các nút số trang -->
        <% 
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);
            
            if (startPage > 1) { %>
                <a href="#" data-page="1" class="w-9 h-9 rounded-xl border border-slate-200 text-slate-700 font-medium flex items-center justify-center hover:bg-slate-50 transition text-xs">1</a>
                <% if (startPage > 2) { %> <span class="text-slate-400 px-1">...</span> <% } %>
            <% } %>

            <% for(let i = startPage; i <= endPage; i++) { %>
                <a href="#" data-page="<%= i %>" 
                   class="w-9 h-9 rounded-xl <%= i === currentPage ? 'bg-blue-600 text-white font-bold shadow-sm' : 'border border-slate-200 text-slate-700 font-medium hover:bg-slate-50' %> flex items-center justify-center transition text-xs">
                    <%= i %>
                </a>
            <% } %>

            <% if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %> <span class="text-slate-400 px-1">...</span> <% } %>
                <a href="#" data-page="<%= totalPages %>" class="w-9 h-9 rounded-xl border border-slate-200 text-slate-700 font-medium flex items-center justify-center hover:bg-slate-50 transition text-xs"><%= totalPages %></a>
            <% } %>

        <!-- Nút Next -->
        <a href="#" data-page="<%= currentPage + 1 %>" 
           class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-50 transition text-xs <%= currentPage === totalPages ? 'pointer-events-none opacity-50' : '' %>">
            <i class="fa-solid fa-chevron-right"></i>
        </a>
    </div>

    <!-- Script tự động giữ lại URL hiện tại và đổi số trang -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const paginationLinks = document.querySelectorAll("#pagination-container a[data-page]");
            
            paginationLinks.forEach(link => {
                link.addEventListener("click", function(e) {
                    e.preventDefault();
                    const targetPage = this.getAttribute("data-page");
                    
                    // Lấy toàn bộ URL hiện tại trên trình duyệt (đã có sẵn id, slug, sort...)
                    const url = new URL(window.location.href);
                    
                    // Cập nhật hoặc thêm tham số page mới
                    url.searchParams.set("page", targetPage);
                    
                    // Chuyển hướng đến URL mới
                    window.location.href = url.toString();
                });
            });
        });
    </script>
<% } %>

                </div>

