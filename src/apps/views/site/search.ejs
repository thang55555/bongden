<script>
    document.addEventListener("DOMContentLoaded", function () {
        const limitSelect = document.getElementById('limit-select');
        const sortSelect = document.getElementById('sort-select');

        // 1. Đồng bộ trạng thái đã chọn (selected) cho các select dựa theo URL khi load trang
        const urlParams = new URLSearchParams(window.location.search);
        
        const currentLimit = urlParams.get('limit');
        if (currentLimit && limitSelect) {
            limitSelect.value = currentLimit;
        }

        const currentSort = urlParams.get('sort');
        if (currentSort && sortSelect) {
            sortSelect.value = currentSort;
        }

        // 2. Hàm chung để cập nhật URL và chuyển hướng
        function updateUrlAndNavigate(paramName, value) {
            let currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set(paramName, value);
            window.location.href = currentUrl.toString();
        }

        // 3. Lắng nghe sự kiện thay đổi của "Hiển thị sản phẩm"
        if (limitSelect) {
            limitSelect.addEventListener('change', function () {
                updateUrlAndNavigate('limit', this.value);
            });
        }

        // 4. Lắng nghe sự kiện thay đổi của "Sắp xếp"
        if (sortSelect) {
            sortSelect.addEventListener('change', function () {
                updateUrlAndNavigate('sort', this.value);
            });
        }
    });
</script>


