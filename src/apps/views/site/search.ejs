<%- include("./layouts/head.ejs")%>
 
    <!-- style category -->
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f8fafc;
            color: #334155;
            font-size: 14px;
            line-height: 1.5;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        .container {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 15px;
        }

        /* HEADER / BANNER */
        .breadcrumb-bar {
            background-image: url('images/banner-bg.png');
            background-size: 100% 100%;
            background-position: center;
            background-repeat: no-repeat;
            color: #fff;
            padding: 25px 0 75px 0;
            /* Tạo khoảng trống phía dưới để sub-nav đè lên */
            position: relative;
        }

        .breadcrumb {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 8px;
        }

        .breadcrumb a {
            color: #cbd5e1;
        }

        .breadcrumb span {
            margin: 0 5px;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-text h2 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .header-text p {
            color: #cbd5e1;
            font-size: 13px;
        }

        .header-imgs {
            display: flex;
            gap: 15px;
        }

        .header-imgs div {
            background: #fff;
            border-radius: 50%;
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
            font-weight: bold;
            color: #0b1c3d;
            font-size: 11px;
        }

        /* SUB-NAV MENU (Hiệu ứng nổi, bo viền và đè lên banner) */
        .sub-nav {
            margin-top: -15px;
            /* Kéo khung lên đè vào banner */
            margin-bottom: 30px;
            position: relative;
            z-index: 10;
        }

        .sub-nav-list {
            background: #fff;
            border: 1px solid #e2e8f0;
            /* Thêm đường viền bao quanh */
            border-radius: 12px;
            /* Bo góc mềm mại */
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
            /* Đổ bóng nổi */
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 15px;
        }

        .sub-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 18px 10px;
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .sub-nav-item.active {
            color: #2563eb;
            border-bottom-color: #2563eb;
        }

        .sub-nav-icon {
            width: 20px;
            height: 20px;
            background: #eff6ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            font-size: 10px;
        }

        /* MAIN LAYOUT */
        .main-layout {
            display: flex;
            gap: 30px;
            padding: 30px 0;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            flex-shrink: 0;
        }

        .sidebar-section {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .sidebar-title {
            font-size: 15px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 15px;
            color: #1e293b;
        }

        .category-menu {
            font-size: 13px;
        }

        .category-item {
            padding: 8px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            color: #475569;
        }

        .category-item.active {
            color: #2563eb;
            font-weight: 600;
        }

        .sub-category {
            padding-left: 15px;
            margin: 5px 0 10px 0;
            border-left: 2px solid #e2e8f0;
        }

        .sub-category li {
            padding: 5px 0;
            color: #64748b;
            cursor: pointer;
            font-size: 12px;
        }

        .sub-category li.active {
            color: #2563eb;
            font-weight: 600;
        }

        .filter-group {
            margin-bottom: 20px;
        }

        .filter-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #334155;
        }

        .range-slider {
            width: 100%;
            margin-bottom: 5px;
        }

        .price-range-vals {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: #64748b;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: #475569;
            margin-bottom: 8px;
            cursor: pointer;
        }

        .checkbox-label input {
            margin-right: 8px;
        }

        .count {
            color: #94a3b8;
            font-size: 11px;
        }

        .btn-reset {
            width: 100%;
            background: #fff;
            border: 1px solid #cbd5e1;
            padding: 8px;
            border-radius: 4px;
            color: #2563eb;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        /* CONTENT AREA */
        .content-area {
            flex-grow: 1;
        }

        .content-header {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .content-header h2 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #1e293b;
        }

        .content-header p {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 15px;
        }

        .sorting-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: #64748b;
        }

        .sorting-options {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .sorting-options select {
            padding: 5px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            background: #fff;
            font-size: 12px;
            color: #334155;
        }

        /* PRODUCTS GRID */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .product-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .discount-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #ef4444;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .product-img {
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            font-size: 40px;
            color: #cbd5e1;
            background: #f8fafc;
            border-radius: 6px;
        }

        .product-brand {
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .product-title {
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 5px;
            height: 36px;
            overflow: hidden;
        }

        .product-spec {
            font-size: 11px;
            color: #64748b;
            margin-bottom: 8px;
        }

        .eco-tag {
            background: #ecfdf5;
            color: #059669;
            font-size: 9px;
            padding: 2px 5px;
            border-radius: 3px;
            display: inline-block;
            margin-bottom: 8px;
        }

        .price-box {
            display: flex;
            align-items: baseline;
            gap: 8px;
            margin-bottom: 10px;
        }

        .current-price {
            font-size: 14px;
            font-weight: 700;
            color: #2563eb;
        }

        .old-price {
            font-size: 11px;
            color: #94a3b8;
            text-decoration: line-through;
        }

        .product-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #f1f5f9;
            padding-top: 8px;
            font-size: 10px;
            color: #cbd5e1;
        }

        .rating {
            color: #f59e0b;
        }

        .btn-cart {
            background: #eff6ff;
            border: none;
            width: 26px;
            height: 26px;
            border-radius: 4px;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* PAGINATION */
        .pagination {
            display: flex;
            justify-content: center;
            gap: 5px;
            margin-top: 20px;
        }

        .page-item {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            font-size: 12px;
            color: #334155;
            cursor: pointer;
        }

        .page-item.active {
            background: #2563eb;
            color: #fff;
            border-color: #2563eb;
        }

        /* FEATURES FOOTER */
        .features-bar {
            background: #fff;
            border-top: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
            padding: 25px 0;
            margin-top: 40px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            text-align: center;
        }

        .feature-item {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .feature-icon {
            width: 36px;
            height: 36px;
            color: #2563eb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .feature-title {
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 2px;
        }

        .feature-desc {
            font-size: 11px;
            color: #64748b;
        }

        /* FOOTER */
        .footer {
            background: #0b1c3d;
            color: #cbd5e1;
            padding: 40px 0 20px 0;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 2fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .footer h3 {
            color: #fff;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .footer p {
            font-size: 12px;
            margin-bottom: 10px;
        }

        .newsletter-box {
            display: flex;
            margin-top: 10px;
        }

        .newsletter-box input {
            padding: 8px 12px;
            border: 1px solid #334155;
            background: #1e293b;
            color: #fff;
            border-radius: 4px 0 0 4px;
            outline: none;
            flex-grow: 1;
            font-size: 12px;
        }

        .newsletter-box button {
            background: #2563eb;
            color: #fff;
            border: none;
            padding: 0 15px;
            border-radius: 0 4px 4px 0;
            font-weight: 600;
            cursor: pointer;
            font-size: 12px;
        }

        .footer-bottom {
            border-top: 1px solid #1e293b;
            padding-top: 15px;
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: #64748b;
        }

        /* Ẩn trên các thiết bị di động có chiều rộng màn hình từ 768px trở xuống */
        @media (max-width: 768px) {

            .breadcrumb-bar,
            .sub-nav {
                display: none !important;
            }
        }
    </style>
    <!-- Container chính -->
    <div class="max-w-[1360px] mx-auto px-4 py-6 md:py-10" style="padding-top:0">

        <!-- BREADCRUMB -->
        <nav class="text-sm text-gray-600 mb-6 md:mb-8">
            <a href="/" class="hover:text-brand-blue">Trang chủ</a>
            <span class="mx-1.5">›</span>
            <span class="text-gray-900 font-medium">Tìm kiếm</span>
        </nav>

        <!-- HEADER KẾT QUẢ TÌM KIẾM -->
        <header class="bg-white p-6 md:p-10 rounded-2xl shadow-sm mb-6 md:mb-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 border border-gray-100">
            <div class="flex items-center gap-6 md:gap-8 flex-1">
<div class="bg-blue-100 p-4 md:p-6 rounded-2xl flex-shrink-0 flex items-center justify-center">
    <i class="fa-solid fa-magnifying-glass text-[#003399] text-3xl md:text-5xl"></i>
</div>
                <div class="flex-1 min-w-0">
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2 truncate">KẾT QUẢ TÌM KIẾM</h2>
                    <p class="text-gray-700 mb-1">Từ khóa: <span class="font-semibold text-brand-blue break-all">"<%=keyword%>"</span></p>
                    <p class="text-gray-600 text-sm">Có <%=totalProducts%> sản phẩm phù hợp</p>
                </div>
            </div>
            <div class="border-t lg:border-l lg:border-t-0 border-gray-100 pt-4 lg:pt-0 lg:pl-8 flex-shrink-0" style="width: 50%;">
                <h3 class="font-semibold text-gray-900 mb-4">Gợi ý tìm kiếm phổ biến</h3>
<div class="flex flex-wrap gap-2.5">
    <% if (product && product.length > 0 && product[0].keywords) { %>
        <% 
            // Dùng Regex /[,|.]+/ để tách chuỗi theo dấu phẩy, dấu gạch đứng hoặc dấu chấm
            let keywordList = product[0].keywords
                .split(/[,|.]+/)
                .map(k => k.trim())
                .filter(k => k.length > 0); // Lọc bỏ các phần tử rỗng nếu có
        %>
        <% keywordList.forEach(kw => { %>
            <a href="/search?keyword=<%= encodeURIComponent(kw) %>" class="bg-brand-lighter text-brand-blue text-sm px-4 py-2 rounded-full hover:bg-blue-200 transition">
                <%= kw %>
            </a>
        <% }) %>
    <% } %>
</div>
            </div>
        </header>

        <!-- NỘI DUNG CHÍNH (BỘ LỌC + LƯỚI SẢN PHẨM) -->
    <!-- MAIN BODY -->
    <div class="features-bar">
        <div class="container ">
            <div class="main-layout">
                <!-- SIDEBAR -->
                <div class="sidebar">
                    <div class="sidebar-section">
                        <div class="sidebar-title">Danh mục sản phẩm</div>

<ul class="category-menu">
  <% if (typeof menu1 !== 'undefined' && menu1.length > 0) { %>
    <% menu1.forEach((item, index) => { %>
      <% 
        // Lọc các menu2 thuộc về menu1 hiện tại dựa vào danhmuc_id
        const subMenus = menu2.filter(sub => {
          if (!sub.danhmuc_id) return false;
          return sub.danhmuc_id.some(id => id.toString() === item._id.toString());
        });
      %>

      <!-- Danh mục cha (Menu1) -->
      <li class="category-item" >
        <span class="category-text"><%= item.name %></span> 
        <span class="arrow">▼</span>
      </li>

      <!-- Danh mục con (Menu2) tương ứng -->
      <ul class="sub-category" style="display: none;">
        <% if (subMenus.length > 0) { %>
          <% subMenus.forEach((sub) => { %>
            <li>
              <a href="/category?danh-muc=<%= sub.slug %>&id=<%= sub._id %>" class="text-inherit"><%= sub.name %></a>
            </li>
          <% }) %>
        <% } else { %>
          <li class="italic text-slate-400">Đang cập nhật...</li>
        <% } %>
      </ul>

    <% }) %>
  <% } %>
</ul>

<!-- Script tự động nhận diện trang hiện tại để Active đúng Menu cha và Menu con -->
<script>
  // Tự động đồng bộ Active cho cả 2 menu dựa theo danh-muc và id hiện tại khi load trang
  document.addEventListener("DOMContentLoaded", function () {
    const currentParams = new URLSearchParams(window.location.search);
    const currentDanhMuc = currentParams.get('danh-muc');
    const currentId = currentParams.get('id');

    // Hàm kiểm tra xem một đường dẫn href có chứa đúng danh-muc và id hiện tại không
    function isMatchingCategory(href) {
      try {
        // Tạo đối tượng URL giả lập để bóc tách tham số từ href của menu
        const urlObj = new URL(href, window.location.origin);
        const linkParams = urlObj.searchParams;
        
        return linkParams.get('danh-muc') === currentDanhMuc && linkParams.get('id') === currentId;
      } catch (e) {
        return false;
      }
    }

    // 1. Xử lý phần sub-nav phía trên
    const subNavLinks = document.querySelectorAll('.sub-nav-list .sub-nav-link');
    subNavLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href && isMatchingCategory(href)) {
        const parentLi = link.closest('.sub-nav-item');
        if (parentLi) parentLi.classList.add('active');
      }
    });

    // 2. Xử lý phần category-menu bên sidebar (cả menu con và menu cha)
    const subCategoryLinks = document.querySelectorAll('.category-menu .sub-category a');
    subCategoryLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href && isMatchingCategory(href)) {
        // Active thẻ li của menu con
        link.parentElement.classList.add('active');

        // Mở ul.sub-category và active menu cha tương ứng
        const subCategoryUl = link.closest('.sub-category');
        if (subCategoryUl) {
          subCategoryUl.style.display = 'block';

          const parentCategoryItem = subCategoryUl.previousElementSibling;
          if (parentCategoryItem && parentCategoryItem.classList.contains('category-item')) {
            parentCategoryItem.classList.add('active');
            const arrow = parentCategoryItem.querySelector('.arrow');
            if (arrow) arrow.textContent = '▲';
          }
        }
      }
    });
  });
</script>
                    </div>

