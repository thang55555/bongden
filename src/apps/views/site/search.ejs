        <input type="checkbox" name="colorTemp" value="Vàng (3000k)" <%= (currentFilters.colorTemp && (Array.isArray(currentFilters.colorTemp) ? currentFilters.colorTemp.includes('Vàng (3000k)') : currentFilters.colorTemp === 'Vàng (3000k)')) ? 'checked' : '' %>> 
        Ánh sáng vàng (2700K - 3500K) <span class="count">(<%= colorCounts['Vàng (3000k)'] %>)</span>
    </label>
    <label class="checkbox-label">
        <input type="checkbox" name="colorTemp" value="Trung Tính(4000k)" <%= (currentFilters.colorTemp && (Array.isArray(currentFilters.colorTemp) ? currentFilters.colorTemp.includes('Trung Tính(4000k)') : currentFilters.colorTemp === 'Trung Tính(4000k)')) ? 'checked' : '' %>> 
        Ánh sáng trung tính (4000K - 4500K) <span class="count">(<%= colorCounts['Trung Tính(4000k)'] %>)</span>
    </label>
    <label class="checkbox-label">
        <input type="checkbox" name="colorTemp" value="Trắng (6500k)" <%= (currentFilters.colorTemp && (Array.isArray(currentFilters.colorTemp) ? currentFilters.colorTemp.includes('Trắng (6500k)') : currentFilters.colorTemp === 'Trắng (6500k)')) ? 'checked' : '' %>> 
        Ánh sáng trắng (6000K - 6500K) <span class="count">(<%= colorCounts['Trắng (6500k)'] %>)</span>
    </label>
</div>

                        <div class="filter-actions">
                            <button class="btn-reset" id="reset-filters">Xóa bộ lọc</button>
                            <button class="btn-submit-filter" id="apply-filters">Tìm kiếm</button>
                        </div>
                        <style>
                            /* Khu vực chứa 2 nút lọc */
                            .filter-actions {
                                display: flex;
