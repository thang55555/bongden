                <script>
                    // 1. Xử lý đóng/mở danh mục sản phẩm (Accordion)
                    document.querySelectorAll('.category-item').forEach(function (item) {
                        item.addEventListener('click', function () {
                            let subMenu = this.nextElementSibling;
                            let arrow = this.querySelector('.arrow');

                            if (subMenu && subMenu.classList.contains('sub-category')) {
                                let isOpen = subMenu.style.display === 'block' || window.getComputedStyle(subMenu).display === 'block';

                                // Đóng tất cả các mục khác
                                document.querySelectorAll('.sub-category').forEach(function (otherSub) {
                                    otherSub.style.display = 'none';
                                });
                                document.querySelectorAll('.category-item').forEach(function (otherItem) {
                                    otherItem.classList.remove('active');
                                    let otherArrow = otherItem.querySelector('.arrow');
                                    if (otherArrow) otherArrow.textContent = '▼';
                                });

                                // Mở mục được click nếu nó đang đóng
                                if (!isOpen) {
                                    subMenu.style.display = 'block';
                                    arrow.textContent = '▲';
                                    this.classList.add('active');
                                }
                            }
                        });
                    });

                    // 2. Xử lý thanh trượt giá (Range Slider)
                    const priceRange = document.getElementById('price-range');
                    const priceOutput = document.getElementById('price-output');

                    function formatCurrency(number) {
                        return new Intl.NumberFormat('vi-VN').format(number) + 'đ';
                    }

                    priceRange.addEventListener('input', function () {
                        priceOutput.textContent = formatCurrency(this.value);
                    });

                    // 3. Xử lý nút Xóa tất cả bộ lọc
                    const resetBtn = document.getElementById('reset-filters');
                    resetBtn.addEventListener('click', function () {
                        // Reset thanh trượt giá về mặc định và cập nhật lại chữ hiển thị
                        if (priceRange && priceOutput) {
                            priceRange.value = 0;
                            priceOutput.textContent = formatCurrency(0);
                        }

                        // Đóng toàn bộ danh mục phụ
                        document.querySelectorAll('.sub-category').forEach(function (subMenu) {
                            subMenu.style.display = 'none';
                        });
                        document.querySelectorAll('.category-item').forEach(function (item) {
                            item.classList.remove('active');
                            let arrow = item.querySelector('.arrow');
                            if (arrow) arrow.textContent = '▼';
                        });

                        // Bỏ chọn tất cả các ô checkbox
                        document.querySelectorAll('.sidebar input[type="checkbox"]').forEach(function (checkbox) {
                            checkbox.checked = false;
                        });
                    });

                    // 4. Xử lý sự kiện khi bấm nút Tìm kiếm
// 4. Xử lý sự kiện khi bấm nút Tìm kiếm
const applyBtn = document.getElementById('apply-filters');
applyBtn.addEventListener('click', function () {
    // 1. Lấy URL hiện tại trên trình duyệt
    let currentUrl = new URL(window.location.href);
        // QUAN TRỌNG: Luôn reset page về 1 mỗi khi bấm tìm kiếm
    currentUrl.searchParams.set('page', '1');

    // 2. Cập nhật hoặc thêm tham số maxPrice vào URL
    currentUrl.searchParams.set('maxPrice', priceRange.value);

    // 3. Xóa các tham số filter/power/colorTemp cũ trước khi lấy mới (tránh bị lặp lại nếu bấm tìm kiếm nhiều lần)
    currentUrl.searchParams.delete('power');
    currentUrl.searchParams.delete('colorTemp');

    // 4. Lấy các checkbox công suất được chọn và thêm vào URL
    document.querySelectorAll('input[name="power"]:checked').forEach(function (cb) {
        currentUrl.searchParams.append('power', cb.value);
    });

    // 5. Lấy các checkbox nhiệt độ màu được chọn và thêm vào URL
    document.querySelectorAll('input[name="colorTemp"]:checked').forEach(function (cb) {
        currentUrl.searchParams.append('colorTemp', cb.value);
    });

    // 6. Chuyển hướng trình duyệt đến URL mới đã được gom đủ tham số
    window.location.href = currentUrl.toString();
});
document.addEventListener("DOMContentLoaded", function () {
    // 1. Lấy tất cả tham số từ URL hiện tại
    const urlParams = new URLSearchParams(window.location.search);


    // 2. Khôi phục lại thanh trượt giá (nếu URL có maxPrice)
    const maxPrice = urlParams.get('maxPrice');
    if (maxPrice) {
        const priceRange = document.getElementById('price-range');
        const priceOutput = document.getElementById('price-output');
        
        priceRange.value = maxPrice;
        // Cập nhật lại text hiển thị giá tiền
        priceOutput.textContent = Number(maxPrice).toLocaleString('vi-VN') + 'đ';
    }

    // 3. Khôi phục lại trạng thái các checkbox Công suất
    const selectedPowers = urlParams.getAll('power'); // Lấy tất cả giá trị power trên URL
    if (selectedPowers.length > 0) {
        document.querySelectorAll('input[name="power"]').forEach(function (cb) {
            if (selectedPowers.includes(cb.value)) {
                cb.checked = true;
            }
        });
    }

    // 4. Khôi phục lại trạng thái các checkbox Nhiệt độ màu
    const selectedColorTemps = urlParams.getAll('colorTemp'); // Lấy tất cả giá trị colorTemp trên URL
    if (selectedColorTemps.length > 0) {
        document.querySelectorAll('input[name="colorTemp"]').forEach(function (cb) {
            if (selectedColorTemps.includes(cb.value)) {
                cb.checked = true;
            }
        });
    }
});
                </script>



