        <input type="checkbox" name="power" value="tren-30w" <%= (currentFilters.power && (Array.isArray(currentFilters.power) ? currentFilters.power.includes('tren-30w') : currentFilters.power === 'tren-30w')) ? 'checked' : '' %>> 
