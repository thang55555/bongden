<div class="pagination">
    <% if (pagination.totalPages > 1) { %>
        <% 
            // Hàm helper để tạo query string an toàn không bị gom mảng thành dấu phẩy
            const buildUrl = (targetPage) => {
                let params = new URLSearchParams();
                for (let key in currentFilters) {
                    if (key === 'page') continue; // Bỏ qua page cũ để gán page mới
                    
                    let val = currentFilters[key];
                    if (Array.isArray(val)) {
                        val.forEach(item => params.append(key, item));
                    } else {
                        params.set(key, val);
                    }
                }
                params.set('page', targetPage);
                return `/category?${params.toString()}`;
            };
        %>

        <!-- Nút Previous (<) -->
        <% if (pagination.currentPage > 1) { %>
            <a href="<%= buildUrl(pagination.currentPage - 1) %>" class="page-item">&lt;</a>
        <% } else { %>
            <div class="page-item disabled">&lt;</div>
        <% } %>

        <!-- Các số trang động -->
        <% 
            let startPage = Math.max(1, pagination.currentPage - 2);
            let endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);

            if (startPage > 1) { %>
                <a href="<%= buildUrl(1) %>" class="page-item">1</a>
                <% if (startPage > 2) { %>
                    <div class="page-item dot">...</div>
                <% } %>
            <% } 

            for (let i = startPage; i <= endPage; i++) { 
        %>
                <a href="<%= buildUrl(i) %>" class="page-item <%= i === pagination.currentPage ? 'active' : '' %>"><%= i %></a>
        <% } 

            if (endPage < pagination.totalPages) { %>
                <% if (endPage < pagination.totalPages - 1) { %>
                    <div class="page-item dot">...</div>
                <% } %>
                <a href="<%= buildUrl(pagination.totalPages) %>" class="page-item"><%= pagination.totalPages %></a>
        <% } %>

        <!-- Nút Next (>) -->
        <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="<%= buildUrl(pagination.currentPage + 1) %>" class="page-item">&gt;</a>
        <% } else { %>
            <div class="page-item disabled">&gt;</div>
        <% } %>
    <% } %>
</div>
 
