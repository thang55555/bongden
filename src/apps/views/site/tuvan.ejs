                    <!-- Script xử lý bật/tắt ô "Nhu cầu khác" và ràng buộc bắt buộc chọn ít nhất 1 checkbox -->
                    <script>
                        const otherCheckbox = document.getElementById('other-checkbox');
                        const otherContainer = document.getElementById('other-input-container');
                        const otherTextInput = document.getElementById('other-text-input');
                        const checkboxes = document.querySelectorAll('.needs-checkbox');
                        const form = document.querySelector('form'); // Giả định form của bạn dùng thẻ <form>

                        // 1. Xử lý hiển thị/ẩn ô nhập "Nhu cầu khác"
                        otherCheckbox.addEventListener('change', function () {
                            if (this.checked) {
                                otherContainer.classList.remove('hidden');
                                otherTextInput.setAttribute('required', 'true');
                                otherTextInput.focus();
                            } else {
                                otherContainer.classList.add('hidden');
                                otherTextInput.removeAttribute('required');
                                otherTextInput.value = '';
                            }
                        });

                        // 2. Ràng buộc bắt buộc chọn ít nhất 1 checkbox trước khi submit form
                        if (form) {
                            form.addEventListener('submit', function (e) {
                                const isChecked = Array.from(checkboxes).some(cb => cb.checked);
                                if (!isChecked) {
                                    e.preventDefault();
                                    alert('Vui lòng chọn ít nhất một nhu cầu tư vấn!');
                                    // Cuộn màn hình tới phần checkbox để người dùng dễ nhìn thấy
                                    document.getElementById('needs-group').scrollIntoView({ behavior: 'smooth', block: 'center' });
                                }
                            });
                        }
                    </script>

                    <!-- Nội dung yêu cầu -->
                    <div class="space-y-1.5">
