                                <input type="checkbox" name="needs" value="Chiếu sáng cửa hàng"
                                    class="needs-checkbox w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                                <span>Chiếu sáng cửa hàng</span>
                            </label>
                            <label class="flex items-center space-x-2 text-xs text-gray-700 cursor-pointer">
                                <input type="checkbox" name="needs" value="Chiếu sáng công cộng"
                                    class="needs-checkbox w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                                <span>Chiếu sáng công cộng</span>
                            </label>
                            <label class="flex items-center space-x-2 text-xs text-gray-700 cursor-pointer">
                                <input type="checkbox" name="needs" value="Dự án / Công trình"
                                    class="needs-checkbox w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                                <span>Dự án / Công trình</span>
                            </label>
                            <label class="flex items-center space-x-2 text-xs text-gray-700 cursor-pointer col-span-2">
                                <input type="checkbox" id="other-checkbox" name="needs" value="khác"
                                    class="needs-checkbox w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                                <span>Nhu cầu khác</span>
                            </label>
                        </div>

                        <!-- Ô nhập hiện ra khi tích chọn "Nhu cầu khác" -->
                        <div id="other-input-container" class="hidden pt-1">
                            <input type="text" id="other-text-input" placeholder="Vui lòng nhập nhu cầu khác của bạn..." name="needs" 
                                class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
