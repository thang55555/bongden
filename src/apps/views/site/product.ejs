                border: 1px solid #e2e8f0;
                border-radius: 8px;
                padding: 12px;
                position: relative;
            }

            /* Style cho hai nút mũi tên trái/phải */
            .related-section .slider-arrow {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                z-index: 10;
                background-color: #ffffff;
                border: 1px solid #cbd5e1;
                color: #1e293b;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
                transition: all 0.2s ease;
            }

            .related-section .slider-arrow:hover {
                background-color: #2563eb;
                color: #ffffff;
                border-color: #2563eb;
            }

            .related-section .slider-arrow.left {
                left: -18px;
            }

            .related-section .slider-arrow.right {
                right: -18px;
            }

            .related-section .related-grid {
                cursor: grab;
                user-select: none;
                /* Tránh bị bôi đen chữ/ảnh khi đang kéo */
            }

            .related-section .related-grid.is-dragging {
                cursor: grabbing;
            }

            /* Thêm hiệu ứng chuyển động mượt mà cho thẻ sản phẩm */
            .related-section .product-card {
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

            /* Khi rê chuột vào (hover): zoom nhẹ lên và nổi bóng đậm hơn */
            .related-section .product-card:hover {
                transform: translateY(-5px) scale(1.02);
                /* Dịch chuyển lên trên một chút và phóng to 2% */
                box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
                z-index: 2;
                /* Đảm bảo thẻ đang zoom nằm đè lên các thẻ bên cạnh */
            }

            /* Thêm dấu chấm ngăn cách nhẹ giữa (98) và lượt xem nếu muốn tinh tế hơn */
            .card-rating span:first-of-type::after {
