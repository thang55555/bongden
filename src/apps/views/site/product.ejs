        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const tabItems = document.querySelectorAll(".tabs-header .tab-item");
                const tabContents = document.querySelectorAll(".tab-content");

                tabItems.forEach(tab => {
                    tab.addEventListener("click", function () {
                        // 1. Xóa class 'active' của tất cả các nút tab
                        tabItems.forEach(t => t.classList.remove("active"));
                        // Thêm class 'active' vào nút vừa được click
                        this.classList.add("active");

                        // 2. Lấy tên tab tương ứng qua thuộc tính data-tab
                        const targetId = this.getAttribute("data-tab");

                        // 3. Ẩn tất cả các khung nội dung đi
                        tabContents.forEach(content => {
                            content.classList.remove("active");
                        });

                        // 4. Hiện khung nội dung có id trùng với data-tab vừa bấm
                        const targetContent = document.getElementById(targetId);
                        if (targetContent) {
                            targetContent.classList.add("active");
                        }
                    });
                });
            });
